//====================================================================================================================//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//@version=6
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//====================================================================================================================//

import TheTradingSpiderMan/MovingAverages/1 as MA
import TheTradingSpiderMan/ColorsLibrary/2 as CLR
import TheTradingSpiderMan/backtest_nr/1 as BT

//====================================================================================================================//
//-Init---------------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

strategy(title = '⚜️ 𝐏𝐞𝐫𝐩𝐞𝐭𝐮𝐚𝐥 𝐒𝐮𝐢𝐭𝐞 [Strat_NR] ⚜️', overlay = false, max_labels_count = 500, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1)

//====================================================================================================================//
//-Constants----------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

BG_COLOR        = color.rgb(0, 0, 0)
BORDER_COLOR    = color.rgb(30, 30, 30)
FRAME_COLOR     = color.rgb(35, 35, 35)
TEXT_COLOR       = color.white

GROUP_GENERAL    = '⚜️ 𝐆𝐞𝐧𝐞𝐫𝐚𝐥 𝐒𝐞𝐭𝐭𝐢𝐧𝐠𝐬 ⚜️'
GROUP_MA         = '⚜️ 𝐌𝐨𝐯𝐢𝐧𝐠 𝐀𝐯𝐞𝐫𝐚𝐠𝐞𝐬 ⚜️'
GROUP_DASHBOARD  = '⚜️ 𝐃𝐚𝐬𝐡𝐛𝐨𝐚𝐫𝐝 ⚜️'
GROUP_COLORS     = '⚜️ 𝐂𝐨𝐥𝐨𝐫𝐬 ⚜️'
GROUP_BACKTEST   = '⚜️ 𝐁𝐚𝐜𝐤𝐭𝐞𝐬𝐭 ⚜️'

//====================================================================================================================//
//-Settings-----------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

// General
i_mode     = input.string('Single', 'Mode', options = ['Single', 'Double'], group = GROUP_GENERAL, tooltip = 'Single: Price above MA = Bullish, Price below MA = Bearish\nDouble: Fast MA crosses above Slow MA = Bullish, crosses below = Bearish')
i_dataMode = input.string('Live', 'Data Mode', options = ['Live', 'Confirmed'], group = GROUP_GENERAL, tooltip = 'Live: Real-time data\nConfirmed: Closed bars only (no repainting)')
i_source   = input.source(close, 'Source', group = GROUP_GENERAL)

// MA / Fast MA
i_maType = input.string('EMA', 'MA Type', options = [
     'SMA', 'EMA', 'WMA', 'VWMA', 'RMA', 'SMMA', 'SWMA',
     'HMA', 'EHMA',
     'DEMA', 'TEMA', 'TMA', 'T3', 'TWMA', 'SWWMA', 'TRIXSMOOTH',
     'ZLEMA', 'LSMA', 'EPMA', 'ILRS',
     'KAMA', 'FRAMA', 'VIDYA', 'VMA', 'VAMA', 'RVMA', 'APEXMA',
     'SUPERSMOOTHER', 'BUTTERWORTH2', 'BUTTERWORTH3', 'INSTANTTREND', 'EDSMA',
     'LAGUERRE', 'ADAPTIVELAGUERRE',
     'ALMA', 'SINWMA', 'GWMA', 'NMA',
     'JMA', 'MCGINLEY', 'CORAL',
     'MEDIANMA', 'GMA', 'HARMONICMA', 'TRIMMEDMA',
     'EVWMA',
     'HWMA', 'GDEMA', 'REMA', 'MODULARFILTER', 'RMT', 'QRMA', 'WILDERSMOOTH',
     'LEOMA', 'AHRENSMA', 'RUNNINGMA', 'PPOMA', 'MAMA', 'FAMAVAL', 'FISHERMA', 'CMA'
     ], group = GROUP_MA, tooltip = 'Single Mode: The MA to compare price against\nDouble Mode: The Fast MA')
i_maLen = input.int(12, 'MA Length', minval = 1, group = GROUP_MA)

// Slow MA (Double mode)
i_slowMaType = input.string('EMA', 'Slow MA Type', options = [
     'SMA', 'EMA', 'WMA', 'VWMA', 'RMA', 'SMMA', 'SWMA',
     'HMA', 'EHMA',
     'DEMA', 'TEMA', 'TMA', 'T3', 'TWMA', 'SWWMA', 'TRIXSMOOTH',
     'ZLEMA', 'LSMA', 'EPMA', 'ILRS',
     'KAMA', 'FRAMA', 'VIDYA', 'VMA', 'VAMA', 'RVMA', 'APEXMA',
     'SUPERSMOOTHER', 'BUTTERWORTH2', 'BUTTERWORTH3', 'INSTANTTREND', 'EDSMA',
     'LAGUERRE', 'ADAPTIVELAGUERRE',
     'ALMA', 'SINWMA', 'GWMA', 'NMA',
     'JMA', 'MCGINLEY', 'CORAL',
     'MEDIANMA', 'GMA', 'HARMONICMA', 'TRIMMEDMA',
     'EVWMA',
     'HWMA', 'GDEMA', 'REMA', 'MODULARFILTER', 'RMT', 'QRMA', 'WILDERSMOOTH',
     'LEOMA', 'AHRENSMA', 'RUNNINGMA', 'PPOMA', 'MAMA', 'FAMAVAL', 'FISHERMA', 'CMA'
     ], group = GROUP_MA, tooltip = 'Only used in Double Mode — the Slow MA for crossover signals')
i_slowMaLen = input.int(21, 'Slow MA Length', minval = 1, group = GROUP_MA)

// Dashboard
i_showDashboard = input.bool(true, 'Show Dashboard', group = GROUP_DASHBOARD)
i_dashPosition  = input.string('Top Right', 'Position', options = ['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], group = GROUP_DASHBOARD)

// Colors
i_colorTheme = input.string('DEFAULT', 'Color Theme', options = ['DEFAULT', 'MONO', 'VAPOR', 'NEON', 'OCEAN', 'SUNSET', 'FOREST', 'CANDY', 'FIRE', 'ICE'], group = GROUP_COLORS)

// Backtest
i_direction  = input.string("Long & Short", "Direction", options = ["Long Only", "Short Only", "Long & Short"], group = GROUP_BACKTEST)
i_startDate  = input.time(defval = timestamp("01 01 2018"), title = "Start Date", group = GROUP_BACKTEST)
i_endDate    = input.time(defval = timestamp("01 01 2099"), title = "End Date", group = GROUP_BACKTEST)
i_btOption   = input.string("Full", "Backtest Table", options = ["Full", "Simple", "None"], group = GROUP_BACKTEST)
i_btPosition = input.string("Bottom Right", "Table Position", options = ["Top Left", "Middle Left", "Bottom Left", "Top Right", "Middle Right", "Bottom Right", "Top Center", "Bottom Center"], group = GROUP_BACKTEST)
i_curveType  = input.string("Equity", "Equity Curve", options = ["Equity", "Open Profit", "Net Profit", "Gross Profit", "None"], group = GROUP_BACKTEST)

//====================================================================================================================//
//-Color Setup--------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

bullColor    = CLR.bullColor(i_colorTheme)
bearColor    = CLR.bearColor(i_colorTheme)
neutralColor = CLR.defaultNeutral()

//====================================================================================================================//
//-Helper Functions---------------------------------------------------------------------------------------------------//
//====================================================================================================================//

fmt(float value, string pattern = "#.####") =>
    na(value) ? "—" : str.tostring(value, pattern)

//====================================================================================================================//
//-Calculation--------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

confirmedOffset = i_dataMode == 'Confirmed' ? 1 : 0

// Compute MAs
float maFast = MA.selector(i_source, i_maLen, i_maType)[confirmedOffset]
float maSlow = MA.selector(i_source, i_slowMaLen, i_slowMaType)[confirmedOffset]
float src    = i_source[confirmedOffset]

// Trend Logic
bool isSingleMode = i_mode == 'Single'
bool isBullish    = isSingleMode ? src > maFast : maFast > maSlow

// Signal Detection
bool bullSignal = isSingleMode ? ta.crossover(src, maFast) : ta.crossover(maFast, maSlow)
bool bearSignal = isSingleMode ? ta.crossunder(src, maFast) : ta.crossunder(maFast, maSlow)

// Trend Color
trendColor = isBullish ? bullColor : bearColor

//====================================================================================================================//
//-Strategy Logic-----------------------------------------------------------------------------------------------------//
//====================================================================================================================//

bool goLong     = i_direction == "Long Only" or i_direction == "Long & Short"
bool goShort    = i_direction == "Short Only" or i_direction == "Long & Short"
bool inDateRange = time >= i_startDate and time <= i_endDate

if inDateRange
    if bullSignal
        if goLong
            strategy.entry("Long", strategy.long)
        if goShort
            strategy.close("Short")
    if bearSignal
        if goLong
            strategy.close("Long")
        if goShort
            strategy.entry("Short", strategy.short)

//====================================================================================================================//
//-Dashboard----------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

dashPos = switch i_dashPosition
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right

var table dashboard = table.new(dashPos, 2, 8, bgcolor = BG_COLOR, border_width = 1, frame_width = 1, border_color = BORDER_COLOR, frame_color = FRAME_COLOR)

string trendText  = isBullish ? "Bullish" : "Bearish"
string modeText   = isSingleMode ? "Price vs MA" : "Crossover"
string fastLabel  = isSingleMode ? i_maType + " (" + str.tostring(i_maLen) + ")" : i_maType + " (" + str.tostring(i_maLen) + ")"
string slowLabel  = i_slowMaType + " (" + str.tostring(i_slowMaLen) + ")"
float  distance   = isSingleMode ? src - maFast : maFast - maSlow
float  distPct    = isSingleMode ? (src - maFast) / maFast * 100 : (maFast - maSlow) / maSlow * 100

if i_showDashboard
    table.cell(dashboard, 0, 0, '⚜️ Perpetual Suite', text_color = TEXT_COLOR, bgcolor = color.new(trendColor, 70), text_halign = text.align_center)
    table.cell(dashboard, 1, 0, '', bgcolor = color.new(trendColor, 70))

    table.cell(dashboard, 0, 1, 'Mode', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 1, modeText, text_color = neutralColor, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 2, 'Trend', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 2, trendText, text_color = trendColor, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 3, isSingleMode ? 'MA' : 'Fast MA', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 3, fastLabel, text_color = neutralColor, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 4, isSingleMode ? 'MA Value' : 'Slow MA', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 4, isSingleMode ? fmt(maFast, '#.##') : slowLabel, text_color = neutralColor, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 5, isSingleMode ? 'Price' : 'Fast Value', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 5, isSingleMode ? fmt(src, '#.##') : fmt(maFast, '#.##'), text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 6, 'Distance', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 6, fmt(distance, '#.##'), text_color = trendColor, bgcolor = BG_COLOR, text_halign = text.align_right)

    table.cell(dashboard, 0, 7, 'Distance %', text_color = TEXT_COLOR, bgcolor = BG_COLOR, text_halign = text.align_left)
    table.cell(dashboard, 1, 7, fmt(distPct, '#.##') + '%', text_color = trendColor, bgcolor = BG_COLOR, text_halign = text.align_right)

//====================================================================================================================//
//-Backtest Table-----------------------------------------------------------------------------------------------------//
//====================================================================================================================//

BT.backtestTable(i_btOption, i_btPosition)

equityCurve = i_curveType != "None" ? BT.curve(i_curveType) : na
plot(equityCurve, 'Equity Curve', color = color.rgb(41, 98, 255), linewidth = 2)

bool longEntry  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool shortEntry = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool longExit   = strategy.position_size <= 0 and strategy.position_size[1] > 0
bool shortExit  = strategy.position_size >= 0 and strategy.position_size[1] < 0
bool inLong     = strategy.position_size > 0
bool inShort    = strategy.position_size < 0
color sigColor = longEntry ? bullColor : shortEntry ? bearColor : longExit ? bearColor : shortExit ? bullColor : inLong ? color.new(bullColor, 60) : inShort ? color.new(bearColor, 60) : color.new(color.gray, 80)
plot(0, 'Signals', color = sigColor, style = plot.style_circles, linewidth = 3)

//====================================================================================================================//
//-Alerts-------------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

if bullSignal
    alert('{{ticker}} {{interval}} — Perpetual Suite [NR]: Bullish signal', alert.freq_once_per_bar)
if bearSignal
    alert('{{ticker}} {{interval}} — Perpetual Suite [NR]: Bearish signal', alert.freq_once_per_bar)
if isBullish != isBullish[1]
    alert('{{ticker}} {{interval}} — Perpetual Suite [NR]: Trend changed', alert.freq_once_per_bar)
