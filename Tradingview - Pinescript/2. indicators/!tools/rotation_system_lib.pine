// Non-Repainting Version - Modified to eliminate repainting vectors
// Library Version - Uses equity_curve library for equity/metrics calculations

// ╔════════════════════════════════════════════════════════════╗
// ║            NON-REPAINTING MODIFICATIONS                   ║
// ╠════════════════════════════════════════════════════════════╣
// ║ 1. Explicit barmerge.lookahead_off on all                 ║
// ║    request.security() calls                               ║
// ║ 2. best_asset[2] for equity (1-bar signal visibility      ║
// ║    buffer before execution)                               ║
// ║ 3. best_asset[1] for display (signal visible 1 bar        ║
// ║    before equity acts on it)                              ║
// ║ 4. barstate.isconfirmed gate prevents intra-bar           ║
// ║    signal flickering on real-time bars                    ║
// ║ 5. Open-to-close returns for strategy equity              ║
// ║    (realistic entry assumption at bar open)               ║
// ║ 6. Removed var persistence bug in BestPerformingAsset     ║
// ╚════════════════════════════════════════════════════════════╝

//@version=6
indicator("Asset Rotation System [NR] [LIB] [InvestorUnknown]", "ASR", max_bars_back = 5000)

// ╔════════════════════════════╗
// ║          IMPORTS           ║
// ╚════════════════════════════╝
//{
import TradingView/ta/9
import TheTradingSpiderMan/equity_curve/1
//}

// ╔════════════════════════════╗
// ║    TREND FUNCTIONS         ║
// ╚════════════════════════════╝
//{

// Resolves source string to built-in series (so it references the security's data inside request.security)
f_resolve_src(simple string src_type) =>
    switch src_type
        "open"   => open
        "high"   => high
        "low"    => low
        "close"  => close
        "hl2"    => hl2
        "hlc3"   => hlc3
        "ohlc4"  => ohlc4
        => close

// Function to get color based on the value of the signal
f_trend_col(series int x) =>
    x > 0 ? color.green : color.red

// RSI
f_rsi(simple string src_type, simple int len) =>
    rsi = ta.rsi(f_resolve_src(src_type), len)
    sig = rsi > 50 ? 1 : 0

// CCI
f_cci(simple string src_type, simple int len) =>
    cci = ta.cci(f_resolve_src(src_type), len)
    sig = cci > 0 ? 1 : 0

// SuperTrend
f_supertrend(simple float factor, simple int len) =>
    [st, dir] = ta.supertrend(factor, len)
    sig = -dir > 0 ? 1 : 0

// DMI
f_dmi(simple int len) =>
    [dip, dim, adx] = ta.dmi(len, 1)
    sig = dip > dim ? 1 : 0

// Parabolic Sar
f_psar(simple float start, simple float increment, simple float max) =>
    sar = ta.sar(start, increment, max)
    sig = sar < close ? 1 : 0

// Mini trend system
f_all(simple string rsi_src, simple int rsi_len,
 simple string cci_src, simple int cci_len,
 simple float st_factor, simple int st_len,
 simple int dmi_len,
 simple float sar_start, simple float sar_inc, simple float sar_max) =>

    rsi = f_rsi(rsi_src, rsi_len)
    cci = f_cci(cci_src, cci_len)
    st  = f_supertrend(st_factor, st_len)
    dmi = f_dmi(dmi_len)
    sar = f_psar(sar_start, sar_inc, sar_max)

    sig = (rsi + cci + st + dmi + sar) > 0 ? 1 : 0

// Function to return opposite of the signal
f_oppose(series int x) =>
    x == 1 ? (0) : (x == 0 ? 1 : 0)

// Function to perform trend analysis
f_trend(simple string clas,
 simple string rsi_src, simple int rsi_len,
 simple string cci_src, simple int cci_len,
 simple float st_factor, simple int st_len,
 simple int dmi_len,
 simple float sar_start, simple float sar_inc, simple float sar_max) =>

    sig = switch clas
        "RSI"           => f_rsi(rsi_src, rsi_len)
        "CCI"           => f_cci(cci_src, cci_len)
        "SuperTrend"    => f_supertrend(st_factor, st_len)
        "DMI"           => f_dmi(dmi_len)
        "PSAR"          => f_psar(sar_start, sar_inc, sar_max)
        "All"           => f_all(rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max)

    [sig, f_oppose(sig)]

// Function to calculate the age of the ticker
f_age() =>
    bars = bar_index + 1
    math.min(bars, 5000)

// Return calculations kept local (library calls inside request.security tuples are unsupported)
f_roc() =>
    roc = ta.roc(close, 1)
    r   = roc / 100

f_roc_entry() =>
    r = (close - open) / open

// Function to find the ticker with the highest value among 7 pairs (ticker, value)
f_BestPerformingAsset(simple string ticker1, series int v1, simple string ticker2, series int v2, simple string ticker3, series int v3,
 simple string ticker4, series int v4, simple string ticker5, series int v5, simple string ticker6, series int v6, simple string ticker7, series int v7) =>
    var array<string> tickers = array.new_string(7, "")
    var array<float> values   = array.new_float(7, 0.0)

    array.set(tickers, 0, ticker1), array.set(values, 0, v1)
    array.set(tickers, 1, ticker2), array.set(values, 1, v2)
    array.set(tickers, 2, ticker3), array.set(values, 2, v3)
    array.set(tickers, 3, ticker4), array.set(values, 3, v4)
    array.set(tickers, 4, ticker5), array.set(values, 4, v5)
    array.set(tickers, 5, ticker6), array.set(values, 5, v6)
    array.set(tickers, 6, ticker7), array.set(values, 6, v7)

    int highestIndex = 0
    for i = 0 to 6
        if array.get(values, i) > array.get(values, highestIndex)
            highestIndex := i

    array.get(tickers, highestIndex)
//}

// ╔════════════════════════════╗
// ║           STRINGS          ║
// ╚════════════════════════════╝
//{
var string tic                      = "Tickers"
var string GS                       = "General Settings"
var string CS                       = "Colo Settings"
var string I1                       = "RSI Settings"
var string I2                       = "CCI Settings"
var string I3                       = "SuperTrend Settings"
var string I4                       = "DMI Settings"
var string I5                       = "Parabolic SAR Settings"
//}

// ╔════════════════════════════╗
// ║           INPUTS           ║
// ╚════════════════════════════╝
//{

// Tickers
simple string ticker1               = input.symbol("INDEX:BTCUSD",      "Asset 1", group = tic, display = display.none)
simple string ticker2               = input.symbol("INDEX:ETHUSD",      "Asset 2", group = tic, display = display.none)
simple string ticker3               = input.symbol("CRYPTO:SOLUSD",     "Asset 3", group = tic, display = display.none)
simple string ticker4               = input.symbol("CRYPTO:XRPUSD",     "Asset 4", group = tic, display = display.none)
simple string ticker5               = input.symbol("CRYPTO:BNBUSD",     "Asset 5", group = tic, display = display.none)
simple string ticker6               = input.symbol("CRYPTO:DOGEUSD",    "Asset 6", group = tic, display = display.none)

// General Settings
simple string trend_classification  = input.string("All", "Trend Classification Method", options = ["RSI", "CCI", "SuperTrend", "DMI", "PSAR", "All"], group = GS, display = display.none)
simple bool   use_custom_startdate  = input.bool(false, "Use Custom Starting Date for Backtest",    group = GS, inline = "CC")
simple float  custom_startdate      = input.time(timestamp("2023-1-1"), "",                         group = GS, inline = "CC", display = display.none)
simple bool   plot_metric_table     = input.bool(true, "Plot Perf. Metrics Table",                  group = GS)

// Color Settings
simple color  asset1_col            = input.color(color.aqua,   "Asset 1",              group = CS, inline = "C1")
simple color  asset2_col            = input.color(color.red,    "Asset 2",              group = CS, inline = "C1")
simple color  asset3_col            = input.color(color.green,  "Asset 3",              group = CS, inline = "C1")
simple color  asset4_col            = input.color(color.purple, "Asset 4",              group = CS, inline = "C2")
simple color  asset5_col            = input.color(color.orange, "Asset 5",              group = CS, inline = "C2")
simple color  asset6_col            = input.color(color.yellow, "Asset 6",              group = CS, inline = "C2")
simple color  usd_col               = input.color(color.white,  "USD",                  group = CS, inline = "C3")
simple color  tab_lab_text_col      = input.color(color.white,  "Table & Lable Text",   group = CS, inline = "C3")

// RSI
simple string rsi_src               = input.string("close", "RSI Source",   options = ["open", "high", "low", "close", "hl2", "hlc3", "ohlc4"], group = I1, display = display.none)
simple int    rsi_len               = input.int(14,       "RSI Length",     group = I1, display = display.none)

// CCI
simple string cci_src               = input.string("close", "CCI Source",   options = ["open", "high", "low", "close", "hl2", "hlc3", "ohlc4"], group = I2, display = display.none)
simple int    cci_len               = input.int(20,       "CCI Length",     group = I2, display = display.none)

// SuperTrend
simple float  st_factor             = input.float(2.0, "SuperTrend Factor", group = I3, display = display.none, step = 0.1)
simple int    st_len                = input.int(14,    "SuperTrend Length", group = I3, display = display.none)

// DMI
simple int    dmi_len               = input.int(14, "DMI Length",           group = I4, display = display.none)

// Parabolic SAR
simple float  sar_start             = input.float(0.02, "PSAR Start",       group = I5, display = display.none, step = 0.001)
simple float  sar_inc               = input.float(0.02, "PSAR Increment",   group = I5, display = display.none, step = 0.001)
simple float  sar_max               = input.float(0.2,  "PSAR Max Value",   group = I5, display = display.none, step = 0.001)
//}

// ╔════════════════════════════╗
// ║       TREND ANALYSIS       ║
// ╚════════════════════════════╝
//{

// All request.security() calls use explicit gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off

// Asset 1 against all assets
[c1_2, c2_1]            = request.security(str.tostring(ticker1 + "/" + ticker2), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c1_3, c3_1]            = request.security(str.tostring(ticker1 + "/" + ticker3), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c1_4, c4_1]            = request.security(str.tostring(ticker1 + "/" + ticker4), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c1_5, c5_1]            = request.security(str.tostring(ticker1 + "/" + ticker5), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c1_6, c6_1]            = request.security(str.tostring(ticker1 + "/" + ticker6), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c1_usd, cusd_1]        = request.security(ticker1, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
// Returns 3 values: age, strategy return (open-to-close), buy-and-hold return (close-to-close)
[c1_age, r1, r1_bah]    = request.security(ticker1, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Asset 2 against all remaining assets
[c2_3, c3_2]            = request.security(str.tostring(ticker2 + "/" + ticker3), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c2_4, c4_2]            = request.security(str.tostring(ticker2 + "/" + ticker4), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c2_5, c5_2]            = request.security(str.tostring(ticker2 + "/" + ticker5), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c2_6, c6_2]            = request.security(str.tostring(ticker2 + "/" + ticker6), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c2_usd, cusd_2]        = request.security(ticker2, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c2_age, r2, r2_bah]    = request.security(ticker2, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Asset 3 against all remaining assets
[c3_4, c4_3]            = request.security(str.tostring(ticker3 + "/" + ticker4), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c3_5, c5_3]            = request.security(str.tostring(ticker3 + "/" + ticker5), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c3_6, c6_3]            = request.security(str.tostring(ticker3 + "/" + ticker6), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c3_usd, cusd_3]        = request.security(ticker3, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c3_age, r3, r3_bah]    = request.security(ticker3, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Asset 4 against all remaining assets
[c4_5, c5_4]            = request.security(str.tostring(ticker4 + "/" + ticker5), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c4_6, c6_4]            = request.security(str.tostring(ticker4 + "/" + ticker6), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c4_usd, cusd_4]        = request.security(ticker4, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c4_age, r4, r4_bah]    = request.security(ticker4, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Asset 5 against all remaining assets
[c5_6, c6_5]            = request.security(str.tostring(ticker5 + "/" + ticker6), "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c5_usd, cusd_5]        = request.security(ticker5, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c5_age, r5, r5_bah]    = request.security(ticker5, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Asset 6 against remaining asset (USD)
[c6_usd, cusd_6]        = request.security(ticker6, "", f_trend(trend_classification, rsi_src, rsi_len, cci_src, cci_len, st_factor, st_len, dmi_len, sar_start, sar_inc, sar_max), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[c6_age, r6, r6_bah]    = request.security(ticker6, "", [f_age(), f_roc_entry(), f_roc()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)


// Calculation of Final Score for each asset (number of assets it is currently outperforming)
series int a1_score         = c1_2 + c1_3 + c1_4 + c1_5 + c1_6 + c1_usd
series int a2_score         = c2_1 + c2_3 + c2_4 + c2_5 + c2_6 + c2_usd
series int a3_score         = c3_1 + c3_2 + c3_4 + c3_5 + c3_6 + c3_usd
series int a4_score         = c4_1 + c4_2 + c4_3 + c4_5 + c4_6 + c4_usd
series int a5_score         = c5_1 + c5_2 + c5_3 + c5_4 + c5_6 + c5_usd
series int a6_score         = c6_1 + c6_2 + c6_3 + c6_4 + c6_5 + c6_usd
series int usd_score        = cusd_1 + cusd_2 + cusd_3 + cusd_4 + cusd_5 + cusd_6

// Determining "Optimal" Asset
series string best_asset    = f_BestPerformingAsset(ticker1, a1_score, ticker2, a2_score, ticker3, a3_score, ticker4, a4_score, ticker5, a5_score, ticker6, a6_score, "USD", usd_score)

// Only lock in best_asset on confirmed (closed) bars - prevents intra-bar flickering
var string confirmed_best_asset = na
if barstate.isconfirmed
    confirmed_best_asset := best_asset
//}

// ╔════════════════════════════════════════════════════════════╗
// ║   EQUITY CURVES & METRICS  (via equity_curve library)     ║
// ╚════════════════════════════════════════════════════════════╝
//{

bool backtest               = c1_age > 1 and c2_age > 1 and c3_age > 1 and c4_age > 1 and c5_age > 1 and c6_age > 1 and (not use_custom_startdate or time > custom_startdate)

// ── Strategy equity state (var = caller-side persistence) ──
var float eq_equity = na
var float eq_peak   = na
var float eq_dd     = 0.0

[eq_new, eq_peak_new, eq_dd_new] = equity_curve.f_equity(ticker1, ticker2, ticker3, ticker4, ticker5, ticker6,
 confirmed_best_asset, r1, r2, r3, r4, r5, r6, backtest, eq_equity, eq_peak, eq_dd)

eq_equity := eq_new
eq_peak   := eq_peak_new
eq_dd     := eq_dd_new

float eq    = eq_new
float dd_eq = math.round(eq_dd, 4)

// ── Buy-and-hold equity state for each asset ──
var float bah1_eq = na, var float bah1_pk = na, var float bah1_dd = 0.0
var float bah2_eq = na, var float bah2_pk = na, var float bah2_dd = 0.0
var float bah3_eq = na, var float bah3_pk = na, var float bah3_dd = 0.0
var float bah4_eq = na, var float bah4_pk = na, var float bah4_dd = 0.0
var float bah5_eq = na, var float bah5_pk = na, var float bah5_dd = 0.0
var float bah6_eq = na, var float bah6_pk = na, var float bah6_dd = 0.0

[bah1_new, bah1_pk_new, bah1_dd_new] = equity_curve.f_buy_and_hold(r1_bah, backtest, bah1_eq, bah1_pk, bah1_dd)
bah1_eq := bah1_new, bah1_pk := bah1_pk_new, bah1_dd := bah1_dd_new
float bah1 = bah1_new
float dd1  = math.round(bah1_dd, 4)

[bah2_new, bah2_pk_new, bah2_dd_new] = equity_curve.f_buy_and_hold(r2_bah, backtest, bah2_eq, bah2_pk, bah2_dd)
bah2_eq := bah2_new, bah2_pk := bah2_pk_new, bah2_dd := bah2_dd_new
float bah2 = bah2_new
float dd2  = math.round(bah2_dd, 4)

[bah3_new, bah3_pk_new, bah3_dd_new] = equity_curve.f_buy_and_hold(r3_bah, backtest, bah3_eq, bah3_pk, bah3_dd)
bah3_eq := bah3_new, bah3_pk := bah3_pk_new, bah3_dd := bah3_dd_new
float bah3 = bah3_new
float dd3  = math.round(bah3_dd, 4)

[bah4_new, bah4_pk_new, bah4_dd_new] = equity_curve.f_buy_and_hold(r4_bah, backtest, bah4_eq, bah4_pk, bah4_dd)
bah4_eq := bah4_new, bah4_pk := bah4_pk_new, bah4_dd := bah4_dd_new
float bah4 = bah4_new
float dd4  = math.round(bah4_dd, 4)

[bah5_new, bah5_pk_new, bah5_dd_new] = equity_curve.f_buy_and_hold(r5_bah, backtest, bah5_eq, bah5_pk, bah5_dd)
bah5_eq := bah5_new, bah5_pk := bah5_pk_new, bah5_dd := bah5_dd_new
float bah5 = bah5_new
float dd5  = math.round(bah5_dd, 4)

[bah6_new, bah6_pk_new, bah6_dd_new] = equity_curve.f_buy_and_hold(r6_bah, backtest, bah6_eq, bah6_pk, bah6_dd)
bah6_eq := bah6_new, bah6_pk := bah6_pk_new, bah6_dd := bah6_dd_new
float bah6 = bah6_new
float dd6  = math.round(bah6_dd, 4)

// ── Lookback counter (stateless via library) ──
var int since_raw = 0
[since, since_raw_new] = equity_curve.f_since(backtest, since_raw)
since_raw := since_raw_new

// ── Performance metrics ──
float[] a_strategy          = equity_curve.f_PerformanceMetrics(eq, since, backtest, dd_eq)
float[] a1                  = equity_curve.f_PerformanceMetrics(bah1, since, backtest, dd1)
float[] a2                  = equity_curve.f_PerformanceMetrics(bah2, since, backtest, dd2)
float[] a3                  = equity_curve.f_PerformanceMetrics(bah3, since, backtest, dd3)
float[] a4                  = equity_curve.f_PerformanceMetrics(bah4, since, backtest, dd4)
float[] a5                  = equity_curve.f_PerformanceMetrics(bah5, since, backtest, dd5)
float[] a6                  = equity_curve.f_PerformanceMetrics(bah6, since, backtest, dd6)
//}

// ╔════════════════════════════╗
// ║      PLOTS AND TABLES      ║
// ╚════════════════════════════╝
//{

// Place all colors into an array for table and functions
color[] colors              = array.new_color(8)

array.set(colors, 0, asset1_col),   array.set(colors, 1, asset2_col)
array.set(colors, 2, asset3_col),   array.set(colors, 3, asset4_col)
array.set(colors, 4, asset5_col),   array.set(colors, 5, asset6_col)
array.set(colors, 6, usd_col),      array.set(colors, 7, tab_lab_text_col)

// Equity curve color uses confirmed_best_asset with [1] offset = signal visible 1 bar before equity acts
plot(eq,   "Best Asset Equity",   color = equity_curve.f_best_asset_col(ticker1, ticker2, ticker3, ticker4, ticker5, ticker6, confirmed_best_asset, backtest, colors), linewidth = 3)
plot(bah1, "Buy and Hold Asset1", color = backtest ? color.new(asset1_col, 30) : color.new(color.white, 100))
plot(bah2, "Buy and Hold Asset2", color = backtest ? color.new(asset2_col, 30) : color.new(color.white, 100))
plot(bah3, "Buy and Hold Asset3", color = backtest ? color.new(asset3_col, 30) : color.new(color.white, 100))
plot(bah4, "Buy and Hold Asset4", color = backtest ? color.new(asset4_col, 30) : color.new(color.white, 100))
plot(bah5, "Buy and Hold Asset5", color = backtest ? color.new(asset5_col, 30) : color.new(color.white, 100))
plot(bah6, "Buy and Hold Asset6", color = backtest ? color.new(asset6_col, 30) : color.new(color.white, 100))

// Labels
if backtest and barstate.islast
    label.new(bar_index + 5, eq,   "Strategy [NR]",                                          color = color.gray,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah1, str.tostring(equity_curve.f_remove_exchange_name(ticker1)),          color = asset1_col,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah2, str.tostring(equity_curve.f_remove_exchange_name(ticker2)),          color = asset2_col,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah3, str.tostring(equity_curve.f_remove_exchange_name(ticker3)),          color = asset3_col,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah4, str.tostring(equity_curve.f_remove_exchange_name(ticker4)),          color = asset4_col,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah5, str.tostring(equity_curve.f_remove_exchange_name(ticker5)),          color = asset5_col,   textcolor = tab_lab_text_col, style = label.style_label_left)
    label.new(bar_index + 5, bah6, str.tostring(equity_curve.f_remove_exchange_name(ticker6)),          color = asset6_col,   textcolor = tab_lab_text_col, style = label.style_label_left)

// Barcolor
barcolor(equity_curve.f_best_asset_col(ticker1, ticker2, ticker3, ticker4, ticker5, ticker6, confirmed_best_asset, backtest, colors))

// Tables
table t = table.new(position.bottom_right,  9, 8, bgcolor = color.new(color.gray, 80), frame_color = color.white, frame_width = 2)
table b = table.new(position.bottom_center, 1, 2, bgcolor = color.new(color.gray, 80), frame_color = color.white, frame_width = 2)

// Performance Metrics Table (created here with var, passed to library)
var table perf_table = table.new(position.top_left, 8, 15, border_width = 1, frame_width = 1, frame_color = color.white)

if barstate.islast

    // Table with Trend Scores //
    // Table Headers
    t.cell(0, 0, text = "")
    t.cell(0, 1, text = str.tostring(equity_curve.f_remove_exchange_name(ticker1)), text_color = asset1_col)
    t.cell(0, 2, text = str.tostring(equity_curve.f_remove_exchange_name(ticker2)), text_color = asset2_col),
    t.cell(0, 3, text = str.tostring(equity_curve.f_remove_exchange_name(ticker3)), text_color = asset3_col),
    t.cell(0, 4, text = str.tostring(equity_curve.f_remove_exchange_name(ticker4)), text_color = asset4_col),
    t.cell(0, 5, text = str.tostring(equity_curve.f_remove_exchange_name(ticker5)), text_color = asset5_col),
    t.cell(0, 6, text = str.tostring(equity_curve.f_remove_exchange_name(ticker6)), text_color = asset6_col),
    t.cell(0, 7, "USD", text_color = usd_col)

    t.cell(1, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker1)), text_color = tab_lab_text_col)
    t.cell(2, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker2)), text_color = tab_lab_text_col),
    t.cell(3, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker3)), text_color = tab_lab_text_col),
    t.cell(4, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker4)), text_color = tab_lab_text_col),
    t.cell(5, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker5)), text_color = tab_lab_text_col),
    t.cell(6, 0, text = str.tostring(equity_curve.f_remove_exchange_name(ticker6)), text_color = tab_lab_text_col),
    t.cell(7, 0, "USD", text_color = tab_lab_text_col)

    // Trend Scores
    t.cell(2, 1, text = str.tostring(c1_2[1]),   text_color = f_trend_col(c1_2[1])),      t.cell(1, 2, text = str.tostring(c2_1[1]),   text_color = f_trend_col(c2_1[1]))
    t.cell(3, 1, text = str.tostring(c1_3[1]),   text_color = f_trend_col(c1_3[1])),      t.cell(1, 3, text = str.tostring(c3_1[1]),   text_color = f_trend_col(c3_1[1]))
    t.cell(4, 1, text = str.tostring(c1_4[1]),   text_color = f_trend_col(c1_4[1])),      t.cell(1, 4, text = str.tostring(c4_1[1]),   text_color = f_trend_col(c4_1[1]))
    t.cell(5, 1, text = str.tostring(c1_5[1]),   text_color = f_trend_col(c1_5[1])),      t.cell(1, 5, text = str.tostring(c5_1[1]),   text_color = f_trend_col(c5_1[1]))
    t.cell(6, 1, text = str.tostring(c1_6[1]),   text_color = f_trend_col(c1_6[1])),      t.cell(1, 6, text = str.tostring(c6_1[1]),   text_color = f_trend_col(c6_1[1]))
    t.cell(7, 1, text = str.tostring(c1_usd[1]), text_color = f_trend_col(c1_usd[1])),    t.cell(1, 7, text = str.tostring(cusd_1[1]), text_color = f_trend_col(cusd_1[1]))

    t.cell(3, 2, text = str.tostring(c2_3[1]),   text_color = f_trend_col(c2_3[1])),      t.cell(2, 3, text = str.tostring(c3_2[1]),   text_color = f_trend_col(c3_2[1]))
    t.cell(4, 2, text = str.tostring(c2_4[1]),   text_color = f_trend_col(c2_4[1])),      t.cell(2, 4, text = str.tostring(c4_2[1]),   text_color = f_trend_col(c4_2[1]))
    t.cell(5, 2, text = str.tostring(c2_5[1]),   text_color = f_trend_col(c2_5[1])),      t.cell(2, 5, text = str.tostring(c5_2[1]),   text_color = f_trend_col(c5_2[1]))
    t.cell(6, 2, text = str.tostring(c2_6[1]),   text_color = f_trend_col(c2_6[1])),      t.cell(2, 6, text = str.tostring(c6_2[1]),   text_color = f_trend_col(c6_2[1]))
    t.cell(7, 2, text = str.tostring(c2_usd[1]), text_color = f_trend_col(c2_usd[1])),    t.cell(2, 7, text = str.tostring(cusd_2[1]), text_color = f_trend_col(cusd_2[1]))

    t.cell(4, 3, text = str.tostring(c3_4[1]),   text_color = f_trend_col(c3_4[1])),      t.cell(3, 4, text = str.tostring(c4_3[1]),   text_color = f_trend_col(c4_3[1]))
    t.cell(5, 3, text = str.tostring(c3_5[1]),   text_color = f_trend_col(c3_5[1])),      t.cell(3, 5, text = str.tostring(c5_3[1]),   text_color = f_trend_col(c5_3[1]))
    t.cell(6, 3, text = str.tostring(c3_6[1]),   text_color = f_trend_col(c3_6[1])),      t.cell(3, 6, text = str.tostring(c6_3[1]),   text_color = f_trend_col(c6_3[1]))
    t.cell(7, 3, text = str.tostring(c3_usd[1]), text_color = f_trend_col(c3_usd[1])),    t.cell(3, 7, text = str.tostring(cusd_3[1]), text_color = f_trend_col(cusd_3[1]))

    t.cell(5, 4, text = str.tostring(c4_5[1]),   text_color = f_trend_col(c4_5[1])),      t.cell(4, 5, text = str.tostring(c5_4[1]),   text_color = f_trend_col(c5_4[1]))
    t.cell(6, 4, text = str.tostring(c4_6[1]),   text_color = f_trend_col(c4_6[1])),      t.cell(4, 6, text = str.tostring(c6_4[1]),   text_color = f_trend_col(c6_4[1]))
    t.cell(7, 4, text = str.tostring(c4_usd[1]), text_color = f_trend_col(c4_usd[1])),    t.cell(4, 7, text = str.tostring(cusd_4[1]), text_color = f_trend_col(cusd_4[1]))

    t.cell(6, 5, text = str.tostring(c5_6[1]),   text_color = f_trend_col(c5_6[1])),      t.cell(5, 6, text = str.tostring(c6_5[1]),   text_color = f_trend_col(c6_5[1]))
    t.cell(7, 5, text = str.tostring(c5_usd[1]), text_color = f_trend_col(c5_usd[1])),    t.cell(5, 7, text = str.tostring(cusd_5[1]), text_color = f_trend_col(cusd_5[1]))

    t.cell(7, 6, text = str.tostring(c6_usd[1]), text_color = f_trend_col(c6_usd[1])),    t.cell(6, 7, text = str.tostring(cusd_6[1]), text_color = f_trend_col(cusd_6[1]))

    // Final Scores
    t.cell(8, 0, "Score",                           text_color = tab_lab_text_col)
    t.cell(8, 1, text = str.tostring(a1_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 2, text = str.tostring(a2_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 3, text = str.tostring(a3_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 4, text = str.tostring(a4_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 5, text = str.tostring(a5_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 6, text = str.tostring(a6_score[1]),  text_color = tab_lab_text_col)
    t.cell(8, 7, text = str.tostring(usd_score[1]), text_color = tab_lab_text_col)

    // Separators
    for x = 1 to 7
        t.cell(x, x, "", bgcolor = color.new(color.gray, 50))


    // Table B //
    b.cell(0, 0, "Best Performing Asset:",                                                   text_color = tab_lab_text_col)
    string _best_name = na(confirmed_best_asset[1]) ? "" : confirmed_best_asset[1]
    string[] _parts   = str.split(_best_name, ":")
    string _display   = array.size(_parts) > 1 ? array.get(_parts, 1) : _best_name
    b.cell(0, 1, text = _display,    text_color = tab_lab_text_col)


    // Performance Metrics Table //
    if plot_metric_table
        equity_curve.f_PerfMetricTable(perf_table, ticker1, ticker2, ticker3, ticker4, ticker5, ticker6, a_strategy, a1, a2, a3, a4, a5, a6, colors)
//}

// ╔════════════════════════════╗
// ║           ALERTS           ║
// ╚════════════════════════════╝
//{
bool alert_cond = barstate.isconfirmed and not na(confirmed_best_asset) and not na(confirmed_best_asset[1]) and (confirmed_best_asset != confirmed_best_asset[1])

alertcondition(alert_cond, "New Optimal Asset [NR]", message = "A new optimal asset has been detected (confirmed on bar close). Check chart for details")
//}
