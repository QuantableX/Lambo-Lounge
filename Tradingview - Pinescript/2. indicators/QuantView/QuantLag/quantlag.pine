avgL1 = math.round(math.avg(cL1_01, cL1_02, cL1_03, cL1_04, cL1_05, cL1_06, cL1_07, cL1_08, cL1_09, cL1_10, cL1_11, cL1_12, cL1_13, cL1_14, cL1_15, cL1_16, cL1_17, cL1_18, cL1_19, cL1_20, cL1_21, cL1_22, cL1_23, cL1_24, cL1_25, cL1_26, cL1_27, cL1_28, cL1_29, cL1_30), 2)
avgL2 = math.round(math.avg(cL2_01, cL2_02, cL2_03, cL2_04, cL2_05, cL2_06, cL2_07, cL2_08, cL2_09, cL2_10, cL2_11, cL2_12, cL2_13, cL2_14, cL2_15, cL2_16, cL2_17, cL2_18, cL2_19, cL2_20, cL2_21, cL2_22, cL2_23, cL2_24, cL2_25, cL2_26, cL2_27, cL2_28, cL2_29, cL2_30), 2)
avgL3 = math.round(math.avg(cL3_01, cL3_02, cL3_03, cL3_04, cL3_05, cL3_06, cL3_07, cL3_08, cL3_09, cL3_10, cL3_11, cL3_12, cL3_13, cL3_14, cL3_15, cL3_16, cL3_17, cL3_18, cL3_19, cL3_20, cL3_21, cL3_22, cL3_23, cL3_24, cL3_25, cL3_26, cL3_27, cL3_28, cL3_29, cL3_30), 2)
