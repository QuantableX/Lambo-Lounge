// Helper: write a cell with correlation value
corrCell(tbl, col, row, val) =>
    table.cell(tbl, col, row, text=str.tostring(math.round(val, 2)), text_color=corrColor(val), bgcolor=BG_COLOR, width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)

// Helper: write score cell
scoreCell(tbl, col, row, val) =>
    table.cell(tbl, col, row, text=str.tostring(val), text_color=corrColor(val), height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)

if barstate.islast and showCorrTable
    // Title
    table.cell(tableCorr, 1, 1, text='⚜️ 𝐐𝐮𝐚𝐧𝐭𝐕𝐢𝐞𝐰 | 𝐐𝐮𝐚𝐧𝐭𝐋𝐚𝐠 ⚜️', text_color=TEXT_COLOR, bgcolor=BG_COLOR, width=TABLE_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=TITLE_TEXT_SIZE)

    // Corners
    table.cell(tableCorr, 0, 0, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    table.cell(tableCorr, lastCol, 0, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    table.cell(tableCorr, 0, lastRow, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    table.cell(tableCorr, lastCol, lastRow, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    // Vertical borders
    table.cell(tableCorr, 0, 1, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    table.cell(tableCorr, lastCol, 1, text='', bgcolor=BORDER_COLOR, width=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    // Horizontal borders
    table.cell(tableCorr, 1, 0, text='', bgcolor=BORDER_COLOR, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)
    table.cell(tableCorr, 1, lastRow, text='', bgcolor=BORDER_COLOR, height=TABLE_SMALL_BORDER, text_size=TITLE_TEXT_SIZE)

    // Header row (row 2)
    table.cell(tableCorr, colLength, 2, text='𝐋𝐞𝐧𝐠𝐭𝐡', text_color=TEXT_COLOR, width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    table.cell(tableCorr, colMain, 2, text=str.format('{0}', mainLag), text_color=color.white, width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)

    // Lower deviation headers (left of main, highest deviation furthest left)
    if numDeviations >= 1
        table.cell(tableCorr, colMain - 1, 2, text=str.tostring(lowerLag1), text_color=color.new(histColor, headerOp1), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 2
        table.cell(tableCorr, colMain - 2, 2, text=str.tostring(lowerLag2), text_color=color.new(histColor, headerOp2), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 3
        table.cell(tableCorr, colMain - 3, 2, text=str.tostring(lowerLag3), text_color=color.new(histColor, headerOp3), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 4
        table.cell(tableCorr, colMain - 4, 2, text=str.tostring(lowerLag4), text_color=color.new(histColor, headerOp4), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 5
        table.cell(tableCorr, colMain - 5, 2, text=str.tostring(lowerLag5), text_color=color.new(histColor, headerOp5), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)

    // Upper deviation headers (right of main)
    if numDeviations >= 1
        table.cell(tableCorr, colMain + 1, 2, text=str.tostring(upperLag1), text_color=color.new(projColor, headerOp1), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 2
        table.cell(tableCorr, colMain + 2, 2, text=str.tostring(upperLag2), text_color=color.new(projColor, headerOp2), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 3
        table.cell(tableCorr, colMain + 3, 2, text=str.tostring(upperLag3), text_color=color.new(projColor, headerOp3), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 4
        table.cell(tableCorr, colMain + 4, 2, text=str.tostring(upperLag4), text_color=color.new(projColor, headerOp4), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
    if numDeviations >= 5
        table.cell(tableCorr, colMain + 5, 2, text=str.tostring(upperLag5), text_color=color.new(projColor, headerOp5), width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)

    // ---- Data rows (rows 3-32): 30 correlation lengths ----
    // Each row: Length | L5..L1 | Main | U1..U5
    for i = 0 to 29
        int r = 3 + i
        float cLen = switch i
            0  => corrLen01
            1  => corrLen02
            2  => corrLen03
            3  => corrLen04
            4  => corrLen05
            5  => corrLen06
            6  => corrLen07
