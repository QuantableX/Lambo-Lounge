// ---- Table Structure ----
// Columns: border | Length | L5 | L4 | L3 | L2 | L1 | Main | U1 | U2 | U3 | U4 | U5 | border
// Max 14 columns (all 5 deviations), min 4 columns (0 deviations: border + length + main + border)
// Rows: border(0) | title(1) | header(2) | 30 data rows(3-32) | score(33) | border(34) = 35 rows
CORR_DATA_COLS = 2 + numDeviations * 2  // length + main + upper devs + lower devs
CORR_COLS = CORR_DATA_COLS + 2  // + 2 borders
CORR_ROWS = 35
lastCol = CORR_COLS - 1
lastRow = CORR_ROWS - 1

// Column index mapping: border=0, length=1, then lower devs (highest first), main, upper devs (lowest first), border
// With numDeviations=3: border | Length | L3 | L2 | L1 | Main | U1 | U2 | U3 | border
colLength = 1
colMain = 1 + numDeviations + 1  // after length + lower devs

var tableCorr = showCorrTable ? table.new(position=getPosition(tablePosition), columns=CORR_COLS, rows=CORR_ROWS, bgcolor=BG_COLOR, border_width=CORR_BORDER_WIDTH, border_color=BORDER_COLOR, frame_color=FRAME_COLOR, frame_width=CORR_FRAME_WIDTH) : na

// Merge cells at top level (matching QuantCore pattern)
if showCorrTable
    // Corners
    table.merge_cells(tableCorr, 0, 0, 0, 0)
    table.merge_cells(tableCorr, 0, lastRow, 0, lastRow)
    table.merge_cells(tableCorr, lastCol, 0, lastCol, 0)
    table.merge_cells(tableCorr, lastCol, lastRow, lastCol, lastRow)
    // Vertical borders
    table.merge_cells(tableCorr, 0, 1, 0, 33)
    table.merge_cells(tableCorr, lastCol, 1, lastCol, 33)
    // Horizontal borders
    table.merge_cells(tableCorr, 1, 0, lastCol - 1, 0)
    table.merge_cells(tableCorr, 1, lastRow, lastCol - 1, lastRow)
    // Title merge
    table.merge_cells(tableCorr, 1, 1, lastCol - 1, 1)

// Average correlation scores
avgM = math.round(math.avg(corrM_01, corrM_02, corrM_03, corrM_04, corrM_05, corrM_06, corrM_07, corrM_08, corrM_09, corrM_10, corrM_11, corrM_12, corrM_13, corrM_14, corrM_15, corrM_16, corrM_17, corrM_18, corrM_19, corrM_20, corrM_21, corrM_22, corrM_23, corrM_24, corrM_25, corrM_26, corrM_27, corrM_28, corrM_29, corrM_30), 2)
avgU1 = math.round(math.avg(cU1_01, cU1_02, cU1_03, cU1_04, cU1_05, cU1_06, cU1_07, cU1_08, cU1_09, cU1_10, cU1_11, cU1_12, cU1_13, cU1_14, cU1_15, cU1_16, cU1_17, cU1_18, cU1_19, cU1_20, cU1_21, cU1_22, cU1_23, cU1_24, cU1_25, cU1_26, cU1_27, cU1_28, cU1_29, cU1_30), 2)
