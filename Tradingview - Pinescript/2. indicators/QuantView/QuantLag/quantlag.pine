//@version=6
indicator("⚜️ 𝐐𝐮𝐚𝐧𝐭𝐋𝐚𝐠 ⚜️", overlay=true, max_bars_back=5000, scale=scale.left)

// Import colors library
import TheTradingSpiderMan/ColorsLibrary/2 as CLR

// Inputs
secondaryAssetInput = input.symbol("(FRED:M2SL+ECONOMICS:EUM2*FX:EURUSD+ECONOMICS:JPM2/FX:USDJPY+ECONOMICS:CNM2/CAPITALCOM:USDCNH)/1000000000000", "Secondary Asset")
mainLag = input.int(50, "Main Lag (Bars)", minval=1)
lagDeviation = input.int(10, "Lag Deviation (Bars)", minval=1)
numDeviations = input.int(5, "Number of Deviations", minval=0, maxval=5, step=1)

// Color theme selection
colorTheme = input.string("DEFAULT", "Color Theme", options=["DEFAULT", "MONO", "VAPOR", "NEON", "OCEAN", "SUNSET", "FOREST", "CANDY", "FIRE", "ICE"])

// Color inverse toggle
inverseColors = input.bool(false, "Inverse Colors (swap before/after)")

// Opacity controls
lineOpacity = input.int(50, "Line Opacity", minval=0, maxval=100)
fillOpacity = input.int(50, "Fill Opacity", minval=0, maxval=100)
opacityStep = input.float(5.0, "Opacity Step", minval=0.0, maxval=50.0, step=0.5)

// Fetch asset data
secondaryAsset = request.security(secondaryAssetInput, timeframe.period, close)

// Calculate deviated lags
upperLag1 = mainLag + lagDeviation * 1
upperLag2 = mainLag + lagDeviation * 2
upperLag3 = mainLag + lagDeviation * 3
upperLag4 = mainLag + lagDeviation * 4
upperLag5 = mainLag + lagDeviation * 5

lowerLag1 = mainLag - lagDeviation * 1
lowerLag2 = mainLag - lagDeviation * 2
lowerLag3 = mainLag - lagDeviation * 3
lowerLag4 = mainLag - lagDeviation * 4
lowerLag5 = mainLag - lagDeviation * 5

// Transition points for plotting
transitionMain = last_bar_index - mainLag

transitionUpper1 = last_bar_index - upperLag1
transitionUpper2 = last_bar_index - upperLag2
transitionUpper3 = last_bar_index - upperLag3
transitionUpper4 = last_bar_index - upperLag4
transitionUpper5 = last_bar_index - upperLag5

transitionLower1 = last_bar_index - lowerLag1
transitionLower2 = last_bar_index - lowerLag2
transitionLower3 = last_bar_index - lowerLag3
transitionLower4 = last_bar_index - lowerLag4
transitionLower5 = last_bar_index - lowerLag5

// Theme-based color functions - returns color based on theme
bullColor(theme) =>
    switch theme
        "DEFAULT" => CLR.defaultBull()
        "MONO" => CLR.monoBull()
        "VAPOR" => CLR.vaporBull()
        "NEON" => CLR.neonBull()
        "OCEAN" => CLR.oceanBull()
        "SUNSET" => CLR.sunsetBull()
        "FOREST" => CLR.forestBull()
        "CANDY" => CLR.candyBull()
        "FIRE" => CLR.fireBull()
        => CLR.iceBull()

bearColor(theme) =>
    switch theme
        "DEFAULT" => CLR.defaultBear()
        "MONO" => CLR.monoBear()
        "VAPOR" => CLR.vaporBear()
        "NEON" => CLR.neonBear()
        "OCEAN" => CLR.oceanBear()
        "SUNSET" => CLR.sunsetBear()
        "FOREST" => CLR.forestBear()
        "CANDY" => CLR.candyBear()
        "FIRE" => CLR.fireBear()
        => CLR.iceBear()

// Color assignment based on inverse toggle
// When inverseColors = false: historical = bull, projected = bear
// When inverseColors = true: historical = bear, projected = bull
histColor = inverseColors ? bearColor(colorTheme) : bullColor(colorTheme)
projColor = inverseColors ? bullColor(colorTheme) : bearColor(colorTheme)

// Plot HISTORICAL lines and fills
mainHist = plot(secondaryAsset[mainLag], "Main Historical", color=histColor, linewidth=4, display=display.pane)

// Opacity calculations (capped at 80 to prevent invisible lines)
histOp1 = math.min(lineOpacity, 80)
histOp2 = math.min(lineOpacity + int(opacityStep * 1), 80)
histOp3 = math.min(lineOpacity + int(opacityStep * 2), 80)
histOp4 = math.min(lineOpacity + int(opacityStep * 3), 80)
histOp5 = math.min(lineOpacity + int(opacityStep * 4), 80)

projOp1 = math.min(lineOpacity, 80)
projOp2 = math.min(lineOpacity + int(opacityStep * 1), 80)
projOp3 = math.min(lineOpacity + int(opacityStep * 2), 80)
projOp4 = math.min(lineOpacity + int(opacityStep * 3), 80)
projOp5 = math.min(lineOpacity + int(opacityStep * 4), 80)

// Header opacity (brighter for deviation headers)
headerOp1 = math.min(histOp1 - 30, 0)
headerOp2 = math.min(histOp2 - 30, 0)
headerOp3 = math.min(histOp3 - 30, 0)
headerOp4 = math.min(histOp4 - 30, 0)
headerOp5 = math.min(histOp5 - 30, 0)

// Upper deviations (conditionally plotted based on numDeviations)
upperHist1 = plot(numDeviations >= 1 ? secondaryAsset[upperLag1] : na, "Upper Historical 1", color=color.new(histColor, histOp1), linewidth=3, display=display.pane)
upperHist2 = plot(numDeviations >= 2 ? secondaryAsset[upperLag2] : na, "Upper Historical 2", color=color.new(histColor, histOp2), linewidth=2, display=display.pane)
upperHist3 = plot(numDeviations >= 3 ? secondaryAsset[upperLag3] : na, "Upper Historical 3", color=color.new(histColor, histOp3), linewidth=1, display=display.pane)
upperHist4 = plot(numDeviations >= 4 ? secondaryAsset[upperLag4] : na, "Upper Historical 4", color=color.new(histColor, histOp4), linewidth=1, display=display.pane)
upperHist5 = plot(numDeviations >= 5 ? secondaryAsset[upperLag5] : na, "Upper Historical 5", color=color.new(histColor, histOp5), linewidth=1, display=display.pane)

// Lower deviations (conditionally plotted based on numDeviations)
lowerHist1 = plot(numDeviations >= 1 ? secondaryAsset[lowerLag1] : na, "Lower Historical 1", color=color.new(histColor, histOp1), linewidth=3, display=display.pane)
lowerHist2 = plot(numDeviations >= 2 ? secondaryAsset[lowerLag2] : na, "Lower Historical 2", color=color.new(histColor, histOp2), linewidth=2, display=display.pane)
lowerHist3 = plot(numDeviations >= 3 ? secondaryAsset[lowerLag3] : na, "Lower Historical 3", color=color.new(histColor, histOp3), linewidth=1, display=display.pane)
lowerHist4 = plot(numDeviations >= 4 ? secondaryAsset[lowerLag4] : na, "Lower Historical 4", color=color.new(histColor, histOp4), linewidth=1, display=display.pane)
lowerHist5 = plot(numDeviations >= 5 ? secondaryAsset[lowerLag5] : na, "Lower Historical 5", color=color.new(histColor, histOp5), linewidth=1, display=display.pane)

// Historical fill opacity calculations (capped at 85)
histFillOp1 = math.min(fillOpacity, 85)
histFillOp2 = math.min(fillOpacity + int(opacityStep * 1), 85)
histFillOp3 = math.min(fillOpacity + int(opacityStep * 2), 85)
histFillOp4 = math.min(fillOpacity + int(opacityStep * 3), 85)
histFillOp5 = math.min(fillOpacity + int(opacityStep * 4), 85)

// Historical fills (conditional)
fill(mainHist, upperHist1, color=numDeviations >= 1 ? color.new(histColor, histFillOp1) : na, title="Upper Fill 1")
fill(upperHist1, upperHist2, color=numDeviations >= 2 ? color.new(histColor, histFillOp2) : na, title="Upper Fill 2")
fill(upperHist2, upperHist3, color=numDeviations >= 3 ? color.new(histColor, histFillOp3) : na, title="Upper Fill 3")
fill(upperHist3, upperHist4, color=numDeviations >= 4 ? color.new(histColor, histFillOp4) : na, title="Upper Fill 4")
fill(upperHist4, upperHist5, color=numDeviations >= 5 ? color.new(histColor, histFillOp5) : na, title="Upper Fill 5")
fill(mainHist, lowerHist1, color=numDeviations >= 1 ? color.new(histColor, histFillOp1) : na, title="Lower Fill 1")
fill(lowerHist1, lowerHist2, color=numDeviations >= 2 ? color.new(histColor, histFillOp2) : na, title="Lower Fill 2")
fill(lowerHist2, lowerHist3, color=numDeviations >= 3 ? color.new(histColor, histFillOp3) : na, title="Lower Fill 3")
fill(lowerHist3, lowerHist4, color=numDeviations >= 4 ? color.new(histColor, histFillOp4) : na, title="Lower Fill 4")
fill(lowerHist4, lowerHist5, color=numDeviations >= 5 ? color.new(histColor, histFillOp5) : na, title="Lower Fill 5")

// Plot PROJECTED lines and store references
mainProj = plot(bar_index >= transitionMain ? secondaryAsset : na, "Main Projection",
  color=projColor, linewidth=4, offset=mainLag, display=display.pane)

// Upper projections (conditional)
upperProj1 = plot(numDeviations >= 1 and bar_index >= transitionUpper1 ? secondaryAsset : na, "Upper Deviation 1",
  color=color.new(projColor, projOp1), linewidth=3, offset=upperLag1, display=display.pane)
upperProj2 = plot(numDeviations >= 2 and bar_index >= transitionUpper2 ? secondaryAsset : na, "Upper Deviation 2",
  color=color.new(projColor, projOp2), linewidth=2, offset=upperLag2, display=display.pane)
upperProj3 = plot(numDeviations >= 3 and bar_index >= transitionUpper3 ? secondaryAsset : na, "Upper Deviation 3",
  color=color.new(projColor, projOp3), linewidth=1, offset=upperLag3, display=display.pane)
upperProj4 = plot(numDeviations >= 4 and bar_index >= transitionUpper4 ? secondaryAsset : na, "Upper Deviation 4",
  color=color.new(projColor, projOp4), linewidth=1, offset=upperLag4, display=display.pane)
upperProj5 = plot(numDeviations >= 5 and bar_index >= transitionUpper5 ? secondaryAsset : na, "Upper Deviation 5",
  color=color.new(projColor, projOp5), linewidth=1, offset=upperLag5, display=display.pane)

// Lower projections (conditional)
lowerProj1 = plot(numDeviations >= 1 and bar_index >= transitionLower1 ? secondaryAsset : na, "Lower Deviation 1",
  color=color.new(projColor, projOp1), linewidth=3, offset=lowerLag1, display=display.pane)
lowerProj2 = plot(numDeviations >= 2 and bar_index >= transitionLower2 ? secondaryAsset : na, "Lower Deviation 2",
  color=color.new(projColor, projOp2), linewidth=2, offset=lowerLag2, display=display.pane)
lowerProj3 = plot(numDeviations >= 3 and bar_index >= transitionLower3 ? secondaryAsset : na, "Lower Deviation 3",
  color=color.new(projColor, projOp3), linewidth=1, offset=lowerLag3, display=display.pane)
lowerProj4 = plot(numDeviations >= 4 and bar_index >= transitionLower4 ? secondaryAsset : na, "Lower Deviation 4",
  color=color.new(projColor, projOp4), linewidth=1, offset=lowerLag4, display=display.pane)
lowerProj5 = plot(numDeviations >= 5 and bar_index >= transitionLower5 ? secondaryAsset : na, "Lower Deviation 5",
  color=color.new(projColor, projOp5), linewidth=1, offset=lowerLag5, display=display.pane)

// Projected fill opacity calculations (capped at 85)
projFillOp1 = math.min(fillOpacity, 85)
projFillOp2 = math.min(fillOpacity + int(opacityStep * 1), 85)
projFillOp3 = math.min(fillOpacity + int(opacityStep * 2), 85)
projFillOp4 = math.min(fillOpacity + int(opacityStep * 3), 85)
projFillOp5 = math.min(fillOpacity + int(opacityStep * 4), 85)

// Projected fills (conditional)
fill(mainProj, upperProj1, color=numDeviations >= 1 ? color.new(projColor, projFillOp1) : na, title="Upper Proj Fill 1")
fill(upperProj1, upperProj2, color=numDeviations >= 2 ? color.new(projColor, projFillOp2) : na, title="Upper Proj Fill 2")
fill(upperProj2, upperProj3, color=numDeviations >= 3 ? color.new(projColor, projFillOp3) : na, title="Upper Proj Fill 3")
fill(upperProj3, upperProj4, color=numDeviations >= 4 ? color.new(projColor, projFillOp4) : na, title="Upper Proj Fill 4")
fill(upperProj4, upperProj5, color=numDeviations >= 5 ? color.new(projColor, projFillOp5) : na, title="Upper Proj Fill 5")
fill(mainProj, lowerProj1, color=numDeviations >= 1 ? color.new(projColor, projFillOp1) : na, title="Lower Proj Fill 1")
fill(lowerProj1, lowerProj2, color=numDeviations >= 2 ? color.new(projColor, projFillOp2) : na, title="Lower Proj Fill 2")
fill(lowerProj2, lowerProj3, color=numDeviations >= 3 ? color.new(projColor, projFillOp3) : na, title="Lower Proj Fill 3")
fill(lowerProj3, lowerProj4, color=numDeviations >= 4 ? color.new(projColor, projFillOp4) : na, title="Lower Proj Fill 4")
fill(lowerProj4, lowerProj5, color=numDeviations >= 5 ? color.new(projColor, projFillOp5) : na, title="Lower Proj Fill 5")

// ============================================================================
// Correlation Analysis Table
// ============================================================================

// Table settings
GROUP_CORR = '⚜️ 𝐂𝐨𝐫𝐫𝐞𝐥𝐚𝐭𝐢𝐨𝐧 𝐀𝐧𝐚𝐥𝐲𝐬𝐢𝐬 ⚜️'
showCorrTable = input.bool(true, "Show Correlation Table", group=GROUP_CORR)
tablePosition = input.string("Middle Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=GROUP_CORR)

// 30 configurable correlation lengths (default 10, 20, 30, ... 300)
corrLen01 = input.int(10,  "Length 01", minval=1, group=GROUP_CORR)
corrLen02 = input.int(20,  "Length 02", minval=1, group=GROUP_CORR)
corrLen03 = input.int(30,  "Length 03", minval=1, group=GROUP_CORR)
corrLen04 = input.int(40,  "Length 04", minval=1, group=GROUP_CORR)
corrLen05 = input.int(50,  "Length 05", minval=1, group=GROUP_CORR)
corrLen06 = input.int(60,  "Length 06", minval=1, group=GROUP_CORR)
corrLen07 = input.int(70,  "Length 07", minval=1, group=GROUP_CORR)
corrLen08 = input.int(80,  "Length 08", minval=1, group=GROUP_CORR)
corrLen09 = input.int(90,  "Length 09", minval=1, group=GROUP_CORR)
corrLen10 = input.int(100, "Length 10", minval=1, group=GROUP_CORR)
corrLen11 = input.int(110, "Length 11", minval=1, group=GROUP_CORR)
corrLen12 = input.int(120, "Length 12", minval=1, group=GROUP_CORR)
corrLen13 = input.int(130, "Length 13", minval=1, group=GROUP_CORR)
corrLen14 = input.int(140, "Length 14", minval=1, group=GROUP_CORR)
corrLen15 = input.int(150, "Length 15", minval=1, group=GROUP_CORR)
corrLen16 = input.int(160, "Length 16", minval=1, group=GROUP_CORR)
corrLen17 = input.int(170, "Length 17", minval=1, group=GROUP_CORR)
corrLen18 = input.int(180, "Length 18", minval=1, group=GROUP_CORR)
corrLen19 = input.int(190, "Length 19", minval=1, group=GROUP_CORR)
corrLen20 = input.int(200, "Length 20", minval=1, group=GROUP_CORR)
corrLen21 = input.int(210, "Length 21", minval=1, group=GROUP_CORR)
corrLen22 = input.int(220, "Length 22", minval=1, group=GROUP_CORR)
corrLen23 = input.int(230, "Length 23", minval=1, group=GROUP_CORR)
corrLen24 = input.int(240, "Length 24", minval=1, group=GROUP_CORR)
corrLen25 = input.int(250, "Length 25", minval=1, group=GROUP_CORR)
corrLen26 = input.int(260, "Length 26", minval=1, group=GROUP_CORR)
corrLen27 = input.int(270, "Length 27", minval=1, group=GROUP_CORR)
corrLen28 = input.int(280, "Length 28", minval=1, group=GROUP_CORR)
corrLen29 = input.int(290, "Length 29", minval=1, group=GROUP_CORR)
corrLen30 = input.int(300, "Length 30", minval=1, group=GROUP_CORR)

// Table styling constants (matching QuantCore)
BG_COLOR        = color.rgb(0, 0, 0)
BORDER_COLOR    = color.rgb(30, 30, 30)
FRAME_COLOR     = color.rgb(35, 35, 35)
TEXT_COLOR       = color.silver
TITLE_TEXT_SIZE  = size.large
SMALL_TEXT_SIZE  = size.normal
TABLE_SMALL_BORDER = 0.01
CORR_FRAME_WIDTH   = 4
CORR_BORDER_WIDTH  = 2
COLUMN_HEIGHT_SIDE = 2.8
COLUMN_WIDTH_SIDE  = 3
TABLE_WIDTH_SIDE   = 10

// Position helper
getPosition(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

// Correlation color function (green for positive, red for negative, gradient by strength)
corrColor(val) =>
    absVal = math.abs(val)
    if na(val)
        color.gray
    else if val > 0
        color.from_gradient(absVal, 0, 1, color.gray, color.rgb(0, 230, 118))
    else
        color.from_gradient(absVal, 0, 1, color.gray, color.rgb(255, 82, 82))

// ---- Calculate correlations for ALL lags at each of the 20 lengths ----

// Main lag correlations
corrM_01 = ta.correlation(close, secondaryAsset[mainLag], corrLen01)
corrM_02 = ta.correlation(close, secondaryAsset[mainLag], corrLen02)
corrM_03 = ta.correlation(close, secondaryAsset[mainLag], corrLen03)
corrM_04 = ta.correlation(close, secondaryAsset[mainLag], corrLen04)
corrM_05 = ta.correlation(close, secondaryAsset[mainLag], corrLen05)
corrM_06 = ta.correlation(close, secondaryAsset[mainLag], corrLen06)
corrM_07 = ta.correlation(close, secondaryAsset[mainLag], corrLen07)
corrM_08 = ta.correlation(close, secondaryAsset[mainLag], corrLen08)
corrM_09 = ta.correlation(close, secondaryAsset[mainLag], corrLen09)
corrM_10 = ta.correlation(close, secondaryAsset[mainLag], corrLen10)
corrM_11 = ta.correlation(close, secondaryAsset[mainLag], corrLen11)
corrM_12 = ta.correlation(close, secondaryAsset[mainLag], corrLen12)
corrM_13 = ta.correlation(close, secondaryAsset[mainLag], corrLen13)
corrM_14 = ta.correlation(close, secondaryAsset[mainLag], corrLen14)
corrM_15 = ta.correlation(close, secondaryAsset[mainLag], corrLen15)
corrM_16 = ta.correlation(close, secondaryAsset[mainLag], corrLen16)
corrM_17 = ta.correlation(close, secondaryAsset[mainLag], corrLen17)
corrM_18 = ta.correlation(close, secondaryAsset[mainLag], corrLen18)
corrM_19 = ta.correlation(close, secondaryAsset[mainLag], corrLen19)
corrM_20 = ta.correlation(close, secondaryAsset[mainLag], corrLen20)
corrM_21 = ta.correlation(close, secondaryAsset[mainLag], corrLen21)
corrM_22 = ta.correlation(close, secondaryAsset[mainLag], corrLen22)
corrM_23 = ta.correlation(close, secondaryAsset[mainLag], corrLen23)
corrM_24 = ta.correlation(close, secondaryAsset[mainLag], corrLen24)
corrM_25 = ta.correlation(close, secondaryAsset[mainLag], corrLen25)
corrM_26 = ta.correlation(close, secondaryAsset[mainLag], corrLen26)
corrM_27 = ta.correlation(close, secondaryAsset[mainLag], corrLen27)
corrM_28 = ta.correlation(close, secondaryAsset[mainLag], corrLen28)
corrM_29 = ta.correlation(close, secondaryAsset[mainLag], corrLen29)
corrM_30 = ta.correlation(close, secondaryAsset[mainLag], corrLen30)

// Upper deviation 1
cU1_01 = ta.correlation(close, secondaryAsset[upperLag1], corrLen01)
cU1_02 = ta.correlation(close, secondaryAsset[upperLag1], corrLen02)
cU1_03 = ta.correlation(close, secondaryAsset[upperLag1], corrLen03)
cU1_04 = ta.correlation(close, secondaryAsset[upperLag1], corrLen04)
cU1_05 = ta.correlation(close, secondaryAsset[upperLag1], corrLen05)
cU1_06 = ta.correlation(close, secondaryAsset[upperLag1], corrLen06)
cU1_07 = ta.correlation(close, secondaryAsset[upperLag1], corrLen07)
cU1_08 = ta.correlation(close, secondaryAsset[upperLag1], corrLen08)
cU1_09 = ta.correlation(close, secondaryAsset[upperLag1], corrLen09)
cU1_10 = ta.correlation(close, secondaryAsset[upperLag1], corrLen10)
cU1_11 = ta.correlation(close, secondaryAsset[upperLag1], corrLen11)
cU1_12 = ta.correlation(close, secondaryAsset[upperLag1], corrLen12)
cU1_13 = ta.correlation(close, secondaryAsset[upperLag1], corrLen13)
cU1_14 = ta.correlation(close, secondaryAsset[upperLag1], corrLen14)
cU1_15 = ta.correlation(close, secondaryAsset[upperLag1], corrLen15)
cU1_16 = ta.correlation(close, secondaryAsset[upperLag1], corrLen16)
cU1_17 = ta.correlation(close, secondaryAsset[upperLag1], corrLen17)
cU1_18 = ta.correlation(close, secondaryAsset[upperLag1], corrLen18)
cU1_19 = ta.correlation(close, secondaryAsset[upperLag1], corrLen19)
cU1_20 = ta.correlation(close, secondaryAsset[upperLag1], corrLen20)
cU1_21 = ta.correlation(close, secondaryAsset[upperLag1], corrLen21)
cU1_22 = ta.correlation(close, secondaryAsset[upperLag1], corrLen22)
cU1_23 = ta.correlation(close, secondaryAsset[upperLag1], corrLen23)
cU1_24 = ta.correlation(close, secondaryAsset[upperLag1], corrLen24)
cU1_25 = ta.correlation(close, secondaryAsset[upperLag1], corrLen25)
cU1_26 = ta.correlation(close, secondaryAsset[upperLag1], corrLen26)
cU1_27 = ta.correlation(close, secondaryAsset[upperLag1], corrLen27)
cU1_28 = ta.correlation(close, secondaryAsset[upperLag1], corrLen28)
cU1_29 = ta.correlation(close, secondaryAsset[upperLag1], corrLen29)
cU1_30 = ta.correlation(close, secondaryAsset[upperLag1], corrLen30)

// Upper deviation 2
cU2_01 = ta.correlation(close, secondaryAsset[upperLag2], corrLen01)
cU2_02 = ta.correlation(close, secondaryAsset[upperLag2], corrLen02)
cU2_03 = ta.correlation(close, secondaryAsset[upperLag2], corrLen03)
cU2_04 = ta.correlation(close, secondaryAsset[upperLag2], corrLen04)
cU2_05 = ta.correlation(close, secondaryAsset[upperLag2], corrLen05)
cU2_06 = ta.correlation(close, secondaryAsset[upperLag2], corrLen06)
cU2_07 = ta.correlation(close, secondaryAsset[upperLag2], corrLen07)
cU2_08 = ta.correlation(close, secondaryAsset[upperLag2], corrLen08)
cU2_09 = ta.correlation(close, secondaryAsset[upperLag2], corrLen09)
cU2_10 = ta.correlation(close, secondaryAsset[upperLag2], corrLen10)
cU2_11 = ta.correlation(close, secondaryAsset[upperLag2], corrLen11)
cU2_12 = ta.correlation(close, secondaryAsset[upperLag2], corrLen12)
cU2_13 = ta.correlation(close, secondaryAsset[upperLag2], corrLen13)
cU2_14 = ta.correlation(close, secondaryAsset[upperLag2], corrLen14)
cU2_15 = ta.correlation(close, secondaryAsset[upperLag2], corrLen15)
cU2_16 = ta.correlation(close, secondaryAsset[upperLag2], corrLen16)
cU2_17 = ta.correlation(close, secondaryAsset[upperLag2], corrLen17)
cU2_18 = ta.correlation(close, secondaryAsset[upperLag2], corrLen18)
cU2_19 = ta.correlation(close, secondaryAsset[upperLag2], corrLen19)
cU2_20 = ta.correlation(close, secondaryAsset[upperLag2], corrLen20)
cU2_21 = ta.correlation(close, secondaryAsset[upperLag2], corrLen21)
cU2_22 = ta.correlation(close, secondaryAsset[upperLag2], corrLen22)
cU2_23 = ta.correlation(close, secondaryAsset[upperLag2], corrLen23)
cU2_24 = ta.correlation(close, secondaryAsset[upperLag2], corrLen24)
cU2_25 = ta.correlation(close, secondaryAsset[upperLag2], corrLen25)
cU2_26 = ta.correlation(close, secondaryAsset[upperLag2], corrLen26)
cU2_27 = ta.correlation(close, secondaryAsset[upperLag2], corrLen27)
cU2_28 = ta.correlation(close, secondaryAsset[upperLag2], corrLen28)
cU2_29 = ta.correlation(close, secondaryAsset[upperLag2], corrLen29)
cU2_30 = ta.correlation(close, secondaryAsset[upperLag2], corrLen30)

// Upper deviation 3
cU3_01 = ta.correlation(close, secondaryAsset[upperLag3], corrLen01)
cU3_02 = ta.correlation(close, secondaryAsset[upperLag3], corrLen02)
cU3_03 = ta.correlation(close, secondaryAsset[upperLag3], corrLen03)
cU3_04 = ta.correlation(close, secondaryAsset[upperLag3], corrLen04)
cU3_05 = ta.correlation(close, secondaryAsset[upperLag3], corrLen05)
cU3_06 = ta.correlation(close, secondaryAsset[upperLag3], corrLen06)
cU3_07 = ta.correlation(close, secondaryAsset[upperLag3], corrLen07)
cU3_08 = ta.correlation(close, secondaryAsset[upperLag3], corrLen08)
