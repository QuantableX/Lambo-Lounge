        // Length label
        table.cell(tableCorr, colLength, r, text=str.tostring(cLen, '#'), text_color=TEXT_COLOR, width=COLUMN_WIDTH_SIDE, height=COLUMN_HEIGHT_SIDE, text_size=SMALL_TEXT_SIZE)
        // Main lag
        corrCell(tableCorr, colMain, r, vM)

        // Upper deviations
        if numDeviations >= 1
            float vU1 = switch i
                0  => cU1_01
                1  => cU1_02
                2  => cU1_03
                3  => cU1_04
                4  => cU1_05
