//Vertical
table.merge_cells(tableFairValue, 0, 1, 0, 3)
table.merge_cells(tableFairValue, 17, 1, 17, 3)
//Horizontal
table.merge_cells(tableFairValue, 1, 0, 17, 0)
table.merge_cells(tableFairValue, 1, 4, 17, 4)

table.merge_cells(tableFairValue, 1, 1, 16, 1)
table.merge_cells(tableFairValue, 1, 2, 5, 2)
table.merge_cells(tableFairValue, 6, 2, 11, 2)
table.merge_cells(tableFairValue, 12, 2, 16, 2)
table.merge_cells(tableFairValue, 1, 3, 8, 3)
table.merge_cells(tableFairValue, 9, 3, 16, 3)

var tableIndicator = table.new(position = position.middle_right, columns = 5, rows = 25, bgcolor = BG_COLOR, border_width = BORDER_WIDTH, border_color = BORDER_COLOR, frame_color = FRAME_COLOR, frame_width = FRAME_WIDTH)
//Corners
table.merge_cells(tableIndicator, 0, 0, 0, 0)
