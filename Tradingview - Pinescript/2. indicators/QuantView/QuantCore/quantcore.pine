trendColor(score) =>
    if color_mode == 'Static'
        score > 0 ? color.new(color_main, 30) : score < 0 ? color.new(color_main, 70) : color.new(color_main, 50)
    else // Gradient mode
        if score < -0.9 and score >= -1
            color.new(color_main, 70)
        else if score < -0.8 and score >= -0.9
            color.new(color_main, 68)
        else if score < -0.7 and score >= -0.8
            color.new(color_main, 66)
        else if score < -0.6 and score >= -0.7
            color.new(color_main, 64)
        else if score < -0.5 and score >= -0.6
            color.new(color_main, 62)
        else if score < -0.4 and score >= -0.5
            color.new(color_main, 60)
        else if score < -0.3 and score >= -0.4
            color.new(color_main, 58)
        else if score < -0.2 and score >= -0.3
            color.new(color_main, 56)
        else if score < -0.1 and score >= -0.2
            color.new(color_main, 54)
        else if score < 0.0 and score >= -0.1
            color.new(color_main, 52)
        else if score == 0.0
            color.new(color_main, 50)
        else if score > 0.0 and score <= 0.1
            color.new(color_main, 48)
        else if score > 0.1 and score <= 0.2
            color.new(color_main, 46)
        else if score > 0.2 and score <= 0.3
            color.new(color_main, 44)
        else if score > 0.3 and score <= 0.4
            color.new(color_main, 42)
        else if score > 0.4 and score <= 0.5
            color.new(color_main, 40)
        else if score > 0.5 and score <= 0.6
            color.new(color_main, 38)
        else if score > 0.6 and score <= 0.7
            color.new(color_main, 36)
        else if score > 0.7 and score <= 0.8
            color.new(color_main, 34)
        else if score > 0.8 and score <= 0.9
            color.new(color_main, 32)
        else if score > 0.9 and score <= 1
            color.new(color_main, 30)
        else
            color.new(color_main, 50)

valuationColor(zscore) =>
    if zscore <= -3
        color.new(color_main, 20)
    else if zscore <= -2.5 and zscore > -3
        color.new(color_main, 25)
    else if zscore <= -2 and zscore > -2.5
        color.new(color_main, 30)
    else if zscore <= -1.5 and zscore > -2
        color.new(color_main, 35)
    else if zscore <= -1 and zscore > -1.5
        color.new(color_main, 40)
    else if zscore <= -0.5 and zscore > -1
        color.new(color_main, 45)
    else if zscore < 0 and zscore > -0.5
        color.new(color_main, 48)
    else if zscore == 0
        color.new(color_main, 50)
    else if zscore > 0 and zscore <= 0.5
        color.new(color_main, 52)
    else if zscore > 0.5 and zscore <= 1
        color.new(color_main, 55)
    else if zscore > 1 and zscore <= 1.5
        color.new(color_main, 60)
    else if zscore > 1.5 and zscore <= 2
        color.new(color_main, 65)
    else if zscore > 2 and zscore <= 2.5
        color.new(color_main, 70)
    else if zscore > 2.5 and zscore <= 3
        color.new(color_main, 75)
    else if zscore > 3
        color.new(color_main, 80)
    else
        color.new(color_main, 50)

// Background color based on Z-Score thresholds (0, 1, 2, 3 and -1, -2, -3)
bgValuationColor(zscore) =>
    if zscore <= -3
        color.new(color_main, 92)
    else if zscore <= -2.5 and zscore > -3
        color.new(color_main, 93)
    else if zscore <= -2 and zscore > -2.5
        color.new(color_main, 94)
    else if zscore <= -1.5 and zscore > -2
        color.new(color_main, 95)
    else if zscore <= -1 and zscore > -1.5
        color.new(color_main, 96)
    else if zscore <= -0.5 and zscore > -1
        color.new(color_main, 97)
    else if zscore < 0 and zscore > -0.5
        color.new(color_main, 98)
    else if zscore == 0
        color.new(color_main, 99)
    else if zscore > 0 and zscore <= 0.5
        color.new(color_main, 98)
    else if zscore > 0.5 and zscore <= 1
        color.new(color_main, 97)
    else if zscore > 1 and zscore <= 1.5
        color.new(color_main, 96)
    else if zscore > 1.5 and zscore <= 2
        color.new(color_main, 95)
    else if zscore > 2 and zscore <= 2.5
        color.new(color_main, 94)
    else if zscore > 2.5 and zscore <= 3
        color.new(color_main, 93)
    else if zscore > 3
        color.new(color_main, 92)
    else
        color.new(color_main, 99)

calcSlope(source, length) =>
    max_bars_back(source, 5000)
    if not barstate.islast or length <= 1
        [float(na), float(na), float(na)]
    else
        sumX = 0.0
        sumY = 0.0
        sumXSqr = 0.0
        sumXY = 0.0
        for i = 0 to length - 1 by 1
            val = source[i]
            per = i + 1.0
            sumX := sumX + per
            sumY := sumY + val
            sumXSqr := sumXSqr + per * per
            sumXY := sumXY + val * per
            sumXY
        slope = (length * sumXY - sumX * sumY) / (length * sumXSqr - sumX * sumX)
        average = sumY / length
        intercept = average - slope * sumX / length + slope
        [slope, average, intercept]

calcDev(source, length, slope, average, intercept) =>
    upDev = 0.0
    dnDev = 0.0
    stdDevAcc = 0.0
    dsxx = 0.0
    dsyy = 0.0
    dsxy = 0.0
    periods = length - 1
    daY = intercept + slope * periods / 2
    val = intercept
    for j = 0 to periods by 1
        price = high[j] - val
        if price > upDev
            upDev := price
            upDev
        price := val - low[j]
        if price > dnDev
            dnDev := price
            dnDev
        price := source[j]
        dxt = price - average
        dyt = val - daY
        price := price - val
        stdDevAcc := stdDevAcc + price * price
        dsxx := dsxx + dxt * dxt
        dsyy := dsyy + dyt * dyt
        dsxy := dsxy + dxt * dyt
        val := val + slope
        val
    stdDev = math.sqrt(stdDevAcc / (periods == 0 ? 1 : periods))
    pearsonR = dsxx == 0 or dsyy == 0 ? 0 : dsxy / math.sqrt(dsxx * dsyy)
    [stdDev, pearsonR, upDev, dnDev]

// QuantDEX: Check if price is above or below MA (returns 1 for above, -1 for below, 0 for equal)
priceVsMA(length, maType) =>
    ma = MA.selector(SOURCE, length, maType)
    SOURCE > ma ? 1 : SOURCE < ma ? -1 : 0

// QuantVAL: Calculate Z-Score of price
priceZScore(length) =>
    mean = ta.sma(SOURCE, length)
    stdDev = ta.stdev(SOURCE, length)
    stdDev != 0 ? (SOURCE - mean) / stdDev : 0.0

//====================================================================================================================//
//-Calculation--------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

// Data Mode: offset for confirmed data (use previous bar data when in Confirmed mode)
confirmedOffset = data_mode == 'Confirmed' ? 1 : 0

//-----QuantDEX: Price vs MA using request.security for timeframes-----//

// Short Term QuantDEX (Y-001 to Y-020)
dexScore_01_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_001_length, Dex_MA_Type))
dexScore_02_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_002_length, Dex_MA_Type))
dexScore_03_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_003_length, Dex_MA_Type))
dexScore_04_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_004_length, Dex_MA_Type))
dexScore_05_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_005_length, Dex_MA_Type))
dexScore_06_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_006_length, Dex_MA_Type))
dexScore_07_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_007_length, Dex_MA_Type))
dexScore_08_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_008_length, Dex_MA_Type))
