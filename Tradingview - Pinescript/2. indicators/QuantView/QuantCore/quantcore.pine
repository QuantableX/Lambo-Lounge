// Apply confirmed offset for Long Term QuantVAL
valScore_01_l = valScore_01_l_raw[confirmedOffset]
valScore_02_l = valScore_02_l_raw[confirmedOffset]
valScore_03_l = valScore_03_l_raw[confirmedOffset]
valScore_04_l = valScore_04_l_raw[confirmedOffset]
valScore_05_l = valScore_05_l_raw[confirmedOffset]
valScore_06_l = valScore_06_l_raw[confirmedOffset]
valScore_07_l = valScore_07_l_raw[confirmedOffset]
valScore_08_l = valScore_08_l_raw[confirmedOffset]
