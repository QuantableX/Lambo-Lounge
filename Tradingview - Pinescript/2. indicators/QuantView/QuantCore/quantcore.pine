//====================================================================================================================//
//-Aggregation--------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

// QuantDEX Aggregate Scores
dexScore_s = math.round(math.avg(dexScore_01_s, dexScore_02_s, dexScore_03_s, dexScore_04_s, dexScore_05_s, dexScore_06_s, dexScore_07_s, dexScore_08_s, dexScore_09_s, dexScore_10_s, dexScore_11_s, dexScore_12_s, dexScore_13_s, dexScore_14_s, dexScore_15_s, dexScore_16_s, dexScore_17_s, dexScore_18_s, dexScore_19_s, dexScore_20_s), 3)

dexScore_l = math.round(math.avg(dexScore_01_l, dexScore_02_l, dexScore_03_l, dexScore_04_l, dexScore_05_l, dexScore_06_l, dexScore_07_l, dexScore_08_l, dexScore_09_l, dexScore_10_l, dexScore_11_l, dexScore_12_l, dexScore_13_l, dexScore_14_l, dexScore_15_l, dexScore_16_l, dexScore_17_l, dexScore_18_l, dexScore_19_l, dexScore_20_l), 3)

// QuantVAL Aggregate Scores
valScore_s = math.round(math.avg(valScore_01_s, valScore_02_s, valScore_03_s, valScore_04_s, valScore_05_s, valScore_06_s, valScore_07_s, valScore_08_s, valScore_09_s, valScore_10_s, valScore_11_s, valScore_12_s, valScore_13_s, valScore_14_s, valScore_15_s, valScore_16_s, valScore_17_s, valScore_18_s, valScore_19_s, valScore_20_s), 2)

valScore_l = math.round(math.avg(valScore_01_l, valScore_02_l, valScore_03_l, valScore_04_l, valScore_05_l, valScore_06_l, valScore_07_l, valScore_08_l, valScore_09_l, valScore_10_l, valScore_11_l, valScore_12_l, valScore_13_l, valScore_14_l, valScore_15_l, valScore_16_l, valScore_17_l, valScore_18_l, valScore_19_l, valScore_20_l), 2)

//-----OSSR: Sharpe, Sortino, Omega Ratios-----//
ossr_lookback = input.int(30, 'Lookback Period', minval = 10, maxval = 500, group = GROUP_OSSR, tooltip = 'Number of bars to calculate ratios')
ossr_periodsPerYear = input.int(365, 'Periods Per Year', minval = 1, maxval = 525600, group = GROUP_OSSR, tooltip = '365 for crypto, 252 for stocks, 52 for weekly, 12 for monthly')
ossr_riskFreeRate = input.float(0.0, 'Risk-Free Rate (%)', minval = 0.0, step = 0.1, group = GROUP_OSSR, tooltip = 'Annual risk-free rate in percentage')

// Calculate returns
ossr_returns = ta.change(close) / close[1]
ossr_meanReturn = ta.sma(ossr_returns, ossr_lookback)
ossr_adjustedRiskFreeRate = (ossr_riskFreeRate / 100) / ossr_periodsPerYear
ossr_excessReturn = ossr_meanReturn - ossr_adjustedRiskFreeRate
ossr_stdDev = ta.stdev(ossr_returns, ossr_lookback)

// Sharpe Ratio
sharpeRatio = ossr_stdDev != 0 ? (ossr_excessReturn / ossr_stdDev) * math.sqrt(ossr_periodsPerYear) : 0

// Sortino Ratio (downside deviation)
float ossr_sumSquaredDownside = 0.0
for i = 0 to ossr_lookback - 1
    ossr_ret = ossr_returns[i]
    ossr_excessRet = ossr_ret - ossr_adjustedRiskFreeRate
    if ossr_excessRet < 0
        ossr_sumSquaredDownside += ossr_excessRet * ossr_excessRet
ossr_downsideDeviation = ossr_lookback > 0 ? math.sqrt(ossr_sumSquaredDownside / ossr_lookback) : 0
sortinoRatio = ossr_downsideDeviation != 0 ? (ossr_excessReturn / ossr_downsideDeviation) * math.sqrt(ossr_periodsPerYear) : 0

// Omega Ratio
float ossr_sumGains = 0.0
float ossr_sumLosses = 0.0
for i = 0 to ossr_lookback - 1
    ossr_ret2 = ossr_returns[i]
    ossr_excessRet2 = ossr_ret2 - ossr_adjustedRiskFreeRate
    if ossr_excessRet2 > 0
        ossr_sumGains += ossr_excessRet2
    else if ossr_excessRet2 < 0
        ossr_sumLosses += math.abs(ossr_excessRet2)
omegaRatio = ossr_sumLosses != 0 ? ossr_sumGains / ossr_sumLosses : (ossr_sumGains > 0 ? 2.0 : 1.0)

//-----EMA System-----//
GROUP_EMA = '⚜️ 𝐄𝐌𝐀 𝐒𝐲𝐬𝐭𝐞𝐦 ⚜️'
emaS_value = input.int(12, minval = 1, title = 'EMA Fast', group = GROUP_EMA)
emaB_value = input.int(21, minval = 1, title = 'EMA Slow', group = GROUP_EMA)
ema50_value = input.int(50, minval = 1, title = 'EMA 50', group = GROUP_EMA)
ema100_value = input.int(100, minval = 1, title = 'EMA 100', group = GROUP_EMA)
ema200_value = input.int(200, minval = 1, title = 'EMA 200', group = GROUP_EMA)
ema_MA_Type = input.string('EMA', 'MA Type', options = ['SMA', 'EMA', 'WMA', 'VWMA', 'RMA', 'HMA', 'DEMA', 'TEMA', 'KAMA', 'T3', 'ALMA', 'FRAMA', 'VIDYA', 'JMA', 'MCGINLEY', 'ZLEMA', 'LSMA', 'TMA', 'SUPERSMOOTHER', 'LAGUERRE'], group = GROUP_EMA, tooltip = 'Select MA type for EMA System')
enableEmaBands = input.bool(true, 'Show EMA Bands', group = GROUP_EMA)
enableEmaBgColor = input.bool(false, 'Enable EMA Background Color', group = GROUP_EMA)
emaUpTrendColor = CLR.bullColor(colorTheme)
emaDownTrendColor = CLR.bearColor(colorTheme)
emaBgBullishCol = CLR.bullColor(colorTheme, 90)
emaBgBearishCol = CLR.bearColor(colorTheme, 90)

emaS = MA.selector(close, emaS_value, ema_MA_Type)
emaB = MA.selector(close, emaB_value, ema_MA_Type)
ema50 = MA.selector(close, ema50_value, ema_MA_Type)
ema100 = MA.selector(close, ema100_value, ema_MA_Type)
ema200 = MA.selector(close, ema200_value, ema_MA_Type)

// EMA Trend State
EMA_UpTrend = emaS >= emaB
EMA_DownTrend = emaS < emaB
emaTrendState = EMA_UpTrend ? 'Bullish' : 'Bearish'
emaTrendColor = EMA_UpTrend ? emaUpTrendColor : emaDownTrendColor

// EMA Spread (deviation between bands as percentage)
emaSpread = math.abs(emaS - emaB) / emaB * 100

// EMA Background Color
emaBgColor = EMA_UpTrend ? emaBgBullishCol : emaBgBearishCol

// EMA Alerts
alertcondition(ta.crossover(emaS, emaB), title = 'EMA Trend Up', message = 'EMA Trend Up - {{ticker}} - {{interval}}')
alertcondition(ta.crossunder(emaS, emaB), title = 'EMA Trend Down', message = 'EMA Trend Down - {{ticker}} - {{interval}}')

