//-----Display-----//
if barstate.islast
    //-----QuantLens (Score Overview)-----//
    // Corners
    table.cell(tableScale, 0, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 8, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 0, 5, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 8, 5, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    // Vertical borders
    table.cell(tableScale, 0, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 8, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    // Horizontal borders
    table.cell(tableScale, 1, 0, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 1, 5, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)

    // Title row
    table.cell(tableScale, 1, 1, text = '⚜️ 𝐐𝐮𝐚𝐧𝐭𝐕𝐢𝐞𝐰 | 𝐐𝐮𝐚𝐧𝐭𝐂𝐨𝐫𝐞 ⚜️', text_color = color_text, bgcolor = BG_COLOR, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)

    // Row 2: Day headers (Day3 | Day2 | Day1) | empty | (Day1 | Day2 | Day3)
    table.cell(tableScale, 1, 2, text = str.tostring(dayOffset3), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 2, 2, text = str.tostring(dayOffset2), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 3, 2, text = str.tostring(dayOffset1), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 4, 2, text = '', text_color = color_text, bgcolor = BG_COLOR, width = 6, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 5, 2, text = str.tostring(dayOffset1), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 6, 2, text = str.tostring(dayOffset2), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)
    table.cell(tableScale, 7, 2, text = str.tostring(dayOffset3), text_color = color_text, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_HALF, text_size = SMALL_TEXT_SIZE)

    // ROC color logic for all days
    valRoc1Color = valScore_roc1 > 0 ? color.new(#00FF00, 50) : valScore_roc1 < 0 ? color.new(#FF0000, 50) : color_text
    valRoc2Color = valScore_roc2 > 0 ? color.new(#00FF00, 50) : valScore_roc2 < 0 ? color.new(#FF0000, 50) : color_text
    valRoc3Color = valScore_roc3 > 0 ? color.new(#00FF00, 50) : valScore_roc3 < 0 ? color.new(#FF0000, 50) : color_text
    dexRoc1Color = dexScore_roc1 > 0 ? color.new(#00FF00, 50) : dexScore_roc1 < 0 ? color.new(#FF0000, 50) : color_text
    dexRoc2Color = dexScore_roc2 > 0 ? color.new(#00FF00, 50) : dexScore_roc2 < 0 ? color.new(#FF0000, 50) : color_text
    dexRoc3Color = dexScore_roc3 > 0 ? color.new(#00FF00, 50) : dexScore_roc3 < 0 ? color.new(#FF0000, 50) : color_text

    // Row 3: Valuation scores (Day3 | Day2 | Day1) | Ticker | Trend scores (Day1 | Day2 | Day3)
    table.cell(tableScale, 1, 3, text = str.tostring(valScore_day3, '#.##'), text_color = valuationColor(valScore_day3), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 2, 3, text = str.tostring(valScore_day2, '#.##'), text_color = valuationColor(valScore_day2), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 3, 3, text = str.tostring(valScore_day1, '#.##'), text_color = valuationColor(valScore_day1), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 4, 3, text = syminfo.ticker, text_color = color_main, bgcolor = BG_COLOR, width = 6, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 5, 3, text = str.tostring(dexScore_day1, '#.###'), text_color = trendColor(dexScore_day1), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 6, 3, text = str.tostring(dexScore_day2, '#.###'), text_color = trendColor(dexScore_day2), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 7, 3, text = str.tostring(dexScore_day3, '#.###'), text_color = trendColor(dexScore_day3), bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)

    // Row 4: ROC symbols (Day3 | Day2 | Day1) | Timeframe | ROC symbols (Day1 | Day2 | Day3)
    valRoc1Sym = valScore_roc1 > 0 ? '▲' : valScore_roc1 < 0 ? '▼' : '➖'
    valRoc2Sym = valScore_roc2 > 0 ? '▲' : valScore_roc2 < 0 ? '▼' : '➖'
    valRoc3Sym = valScore_roc3 > 0 ? '▲' : valScore_roc3 < 0 ? '▼' : '➖'
    dexRoc1Sym = dexScore_roc1 > 0 ? '▲' : dexScore_roc1 < 0 ? '▼' : '➖'
    dexRoc2Sym = dexScore_roc2 > 0 ? '▲' : dexScore_roc2 < 0 ? '▼' : '➖'
    dexRoc3Sym = dexScore_roc3 > 0 ? '▲' : dexScore_roc3 < 0 ? '▼' : '➖'
    table.cell(tableScale, 1, 4, text = str.format('{0}{1}{0}', valRoc3Sym, str.tostring(math.abs(valScore_roc3), '#.##')), text_color = valRoc3Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 2, 4, text = str.format('{0}{1}{0}', valRoc2Sym, str.tostring(math.abs(valScore_roc2), '#.##')), text_color = valRoc2Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 3, 4, text = str.format('{0}{1}{0}', valRoc1Sym, str.tostring(math.abs(valScore_roc1), '#.##')), text_color = valRoc1Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 4, 4, text = timeframe.period, text_color = color_text, bgcolor = BG_COLOR, width = 6, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 5, 4, text = str.format('{0}{1}{0}', dexRoc1Sym, str.tostring(math.abs(dexScore_roc1), '#.###')), text_color = dexRoc1Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 6, 4, text = str.format('{0}{1}{0}', dexRoc2Sym, str.tostring(math.abs(dexScore_roc2), '#.###')), text_color = dexRoc2Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableScale, 7, 4, text = str.format('{0}{1}{0}', dexRoc3Sym, str.tostring(math.abs(dexScore_roc3), '#.###')), text_color = dexRoc3Color, bgcolor = BG_COLOR, width = 5, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)

    //-----Fair Value Metrics-----//
    table.cell(table_id = tableFairValue, column = 1, row = 1, text = '🔱 𝐐𝐮𝐚𝐧𝐭𝐌𝐞𝐭𝐫𝐢𝐜𝐬 🔱', text_color = color_text, bgcolor = BG_COLOR, width = TABLE_WIDTH_CENTER, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    //Corners
    table.cell(tableFairValue, 0, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 17, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 0, 4, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 17, 4, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    //Vertical
    table.cell(tableFairValue, 0, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 17, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    //Horizontal
    table.cell(tableFairValue, 1, 0, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 1, 4, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    //OSSR Ratios (normalize to -1 to 1 for trendColor)
    sharpeNorm = math.max(-1, math.min(1, sharpeRatio / 3))
    sortinoNorm = math.max(-1, math.min(1, sortinoRatio / 3))
    omegaNorm = math.max(-1, math.min(1, (omegaRatio - 1)))
    table.cell(tableFairValue, 1, 2, text = str.format('𝐒𝐡𝐚𝐫𝐩𝐞: {0}', str.tostring(sharpeRatio, '#.##')), text_color = trendColor(sharpeNorm), width = COLUMN_WIDTH_1, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 6, 2, text = str.format('𝐒𝐨𝐫𝐭𝐢𝐧𝐨: {0}', str.tostring(sortinoRatio, '#.##')), text_color = trendColor(sortinoNorm), width = COLUMN_WIDTH_1 * 1.25, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 12, 2, text = str.format('𝐎𝐦𝐞𝐠𝐚: {0}', str.tostring(omegaRatio, '#.##')), text_color = trendColor(omegaNorm), width = COLUMN_WIDTH_1, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    //EMA System Info
    emaTrendNorm = EMA_UpTrend ? 1 : -1
    table.cell(tableFairValue, 1, 3, text = str.format('𝐄𝐌𝐀: {0}', emaTrendState), text_color = trendColor(emaTrendNorm), width = COLUMN_WIDTH_4, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)
    table.cell(tableFairValue, 9, 3, text = str.format('𝐒𝐩𝐫𝐞𝐚𝐝: {0}%', str.tostring(emaSpread, '#.##')), text_color = color_text, width = COLUMN_WIDTH_4, height = COLUMN_HEIGHT_1, text_size = TITLE_TEXT_SIZE)

    //-----Indicators-----//
    table.cell(table_id = tableIndicator, column = 1, row = 1, text = '⚡ 𝐐𝐮𝐚𝐧𝐭𝐃𝐄𝐗 ⚡', text_color = color_text, bgcolor = BG_COLOR, width = TABLE_WIDTH_SIDE, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    //Corners
    table.cell(tableIndicator, 0, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 4, 0, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 0, 24, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 4, 24, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    //Vertical
    table.cell(tableIndicator, 0, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 4, 1, text = '', bgcolor = BORDER_COLOR, width = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    //Horizontal
    table.cell(tableIndicator, 1, 0, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 24, text = '', bgcolor = BORDER_COLOR, height = TABLE_SMALL_BORDER, text_size = TITLE_TEXT_SIZE)

    // Indicator Names
    table.cell(tableIndicator, 1, 2, text = '𝐈𝐧𝐝𝐢𝐜𝐚𝐭𝐨𝐫', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 3, text = '𝕐-𝟘𝟘𝟙', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 4, text = '𝕐-𝟘𝟘𝟚', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 5, text = '𝕐-𝟘𝟘𝟛', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 6, text = '𝕐-𝟘𝟘𝟜', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 7, text = '𝕐-𝟘𝟘𝟝', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 8, text = '𝕐-𝟘𝟘𝟞', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 9, text = '𝕐-𝟘𝟘𝟟', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 10, text = '𝕐-𝟘𝟘𝟠', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 11, text = '𝕐-𝟘𝟘𝟡', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 12, text = '𝕐-𝟘𝟙𝟘', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 13, text = '𝕐-𝟘𝟙𝟙', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 14, text = '𝕐-𝟘𝟙𝟚', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 15, text = '𝕐-𝟘𝟙𝟛', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 16, text = '𝕐-𝟘𝟙𝟜', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 17, text = '𝕐-𝟘𝟙𝟝', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 18, text = '𝕐-𝟘𝟙𝟞', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 19, text = '𝕐-𝟘𝟙𝟟', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 20, text = '𝕐-𝟘𝟙𝟠', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 21, text = '𝕐-𝟘𝟙𝟡', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 1, 22, text = '𝕐-𝟘𝟚𝟘', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    // Indicator Scores Medium Term
    table.cell(tableIndicator, 2, 2, text = '𝐒𝐡𝐨𝐫𝐭-𝐓𝐞𝐫𝐦', text_color = color_text, width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableIndicator, 2, 3, text = dexScore_01_s > 0 ? '▲' : dexScore_01_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_01_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 4, text = dexScore_02_s > 0 ? '▲' : dexScore_02_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_02_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 5, text = dexScore_03_s > 0 ? '▲' : dexScore_03_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_03_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 6, text = dexScore_04_s > 0 ? '▲' : dexScore_04_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_04_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 7, text = dexScore_05_s > 0 ? '▲' : dexScore_05_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_05_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 8, text = dexScore_06_s > 0 ? '▲' : dexScore_06_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_06_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 9, text = dexScore_07_s > 0 ? '▲' : dexScore_07_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_07_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 10, text = dexScore_08_s > 0 ? '▲' : dexScore_08_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_08_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 11, text = dexScore_09_s > 0 ? '▲' : dexScore_09_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_09_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 12, text = dexScore_10_s > 0 ? '▲' : dexScore_10_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_10_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 13, text = dexScore_11_s > 0 ? '▲' : dexScore_11_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_11_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 14, text = dexScore_12_s > 0 ? '▲' : dexScore_12_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_12_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 15, text = dexScore_13_s > 0 ? '▲' : dexScore_13_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_13_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 16, text = dexScore_14_s > 0 ? '▲' : dexScore_14_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_14_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 17, text = dexScore_15_s > 0 ? '▲' : dexScore_15_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_15_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 18, text = dexScore_16_s > 0 ? '▲' : dexScore_16_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_16_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 19, text = dexScore_17_s > 0 ? '▲' : dexScore_17_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_17_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 20, text = dexScore_18_s > 0 ? '▲' : dexScore_18_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_18_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 21, text = dexScore_19_s > 0 ? '▲' : dexScore_19_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_19_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    table.cell(tableIndicator, 2, 22, text = dexScore_20_s > 0 ? '▲' : dexScore_20_s < 0 ? '▼' : '➖', text_size = TITLE_TEXT_SIZE, text_color = trendColor(dexScore_20_s), width = COLUMN_WIDTH_2, height = COLUMN_HEIGHT_SIDE)
    // Indicator Scores Long Term
