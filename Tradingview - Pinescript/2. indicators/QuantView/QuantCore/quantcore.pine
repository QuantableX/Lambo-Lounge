//-Output-------------------------------------------------------------------------------------------------------------//
//====================================================================================================================//

//-----Init QuantLens-----//

// Calculate historical scores using custom offsets
valScore_day1 = valScore_s[dayOffset1]
valScore_day2 = valScore_s[dayOffset2]
valScore_day3 = valScore_s[dayOffset3]
dexScore_day1 = dexScore_s[dayOffset1]
dexScore_day2 = dexScore_s[dayOffset2]
dexScore_day3 = dexScore_s[dayOffset3]

// Calculate ROC based on mode
useFromToday = rocMode == 'From Today'
// Previous Day mode: change between consecutive days
// From Today mode: change from current day to each historical day
valScore_roc1 = valScore_s - valScore_day1
valScore_roc2 = useFromToday ? valScore_s - valScore_day2 : valScore_day1 - valScore_day2
valScore_roc3 = useFromToday ? valScore_s - valScore_day3 : valScore_day2 - valScore_day3
dexScore_roc1 = dexScore_s - dexScore_day1
dexScore_roc2 = useFromToday ? dexScore_s - dexScore_day2 : dexScore_day1 - dexScore_day2
dexScore_roc3 = useFromToday ? dexScore_s - dexScore_day3 : dexScore_day2 - dexScore_day3

// Table: 9 columns (border + 3 val days + center + 3 dex days + border), 6 rows
var tableScale = table.new(position = position.bottom_center, columns = 9, rows = 6, bgcolor = BG_COLOR, border_width = BORDER_WIDTH, border_color = BORDER_COLOR, frame_color = FRAME_COLOR, frame_width = FRAME_WIDTH)
//Corners
table.merge_cells(tableScale, 0, 0, 0, 0)
table.merge_cells(tableScale, 8, 0, 8, 0)
table.merge_cells(tableScale, 0, 5, 0, 5)
table.merge_cells(tableScale, 8, 5, 8, 5)
//Vertical
table.merge_cells(tableScale, 0, 1, 0, 4)
table.merge_cells(tableScale, 8, 1, 8, 4)
//Horizontal
table.merge_cells(tableScale, 1, 0, 7, 0)
table.merge_cells(tableScale, 1, 5, 7, 5)
// Title row merge
table.merge_cells(tableScale, 1, 1, 7, 1)

var tableFairValue = table.new(position = position.top_center, columns = 18, rows = 5, bgcolor = BG_COLOR, border_width = BORDER_WIDTH, border_color = BORDER_COLOR, frame_color = FRAME_COLOR, frame_width = FRAME_WIDTH)
//Corners
