table.merge_cells(tableIndicator, 4, 24, 4, 24)
//Vertical
table.merge_cells(tableIndicator, 0, 1, 0, 23)
table.merge_cells(tableIndicator, 4, 1, 4, 23)
//Horizontal
table.merge_cells(tableIndicator, 1, 0, 3, 0)
table.merge_cells(tableIndicator, 1, 24, 3, 24)

table.merge_cells(tableIndicator, 1, 1, 3, 1)

var tableValuation = table.new(position = position.middle_left, columns = 5, rows = 25, bgcolor = BG_COLOR, border_width = BORDER_WIDTH, border_color = BORDER_COLOR, frame_color = FRAME_COLOR, frame_width = FRAME_WIDTH)
//Corners
