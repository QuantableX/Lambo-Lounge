    table.cell(tableValuation, 2, 23, text = str.tostring(valScore_s), text_color = valuationColor(valScore_s), height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)
    table.cell(tableValuation, 3, 23, text = str.tostring(valScore_l), text_color = valuationColor(valScore_l), height = COLUMN_HEIGHT_SIDE, text_size = TITLE_TEXT_SIZE)

plot(dexScore_s, 'DEX Short-Term', color = trendColor(dexScore_s), display = display.status_line)
plot(dexScore_l, 'DEX Long-Term', color = trendColor(dexScore_l), display = display.status_line)
plot(valScore_s, 'VAL Short-Term', color = valuationColor(valScore_s), display = display.status_line)
plot(valScore_l, 'VAL Long-Term', color = valuationColor(valScore_l), display = display.status_line)
plot(ta.roc(close, 1), 'Close % Change', color = color_text, display = display.status_line)

//-----EMA System Plots-----//
plot(enableEmaBands ? emaS : na, color = emaTrendColor, title = 'EMA Fast', style = plot.style_line, linestyle = plot.linestyle_dotted , linewidth = 2, format = format.volume, display = display.pane)
plot(enableEmaBands ? emaB : na, color = emaTrendColor, title = 'EMA Slow', style = plot.style_line, linestyle = plot.linestyle_dotted , linewidth = 2, format = format.volume, display = display.pane)
// Independent EMAs with price-based coloring
plot(enableEmaBands ? ema50 : na, color = close >= ema50 ? emaUpTrendColor : emaDownTrendColor, title = 'EMA 50', style = plot.style_line, linewidth = 2, format = format.volume, display = display.pane)
plot(enableEmaBands ? ema100 : na, color = close >= ema100 ? emaUpTrendColor : emaDownTrendColor, title = 'EMA 100', style = plot.style_line, linewidth = 3, format = format.volume, display = display.pane)
plot(enableEmaBands ? ema200 : na, color = close >= ema200 ? emaUpTrendColor : emaDownTrendColor, title = 'EMA 200', style = plot.style_line, linewidth = 4, format = format.volume, display = display.pane)
bgcolor(enableEmaBgColor ? emaBgColor : na, title = 'EMA Background')

//-----Plot Candles-----//
// Use bull/bear colors from the library based on dexScore_s
trend_color = dexScore_s > 0 ? CLR.bullColor(colorTheme) : dexScore_s < 0 ? CLR.bearColor(colorTheme) : CLR.bullColor(colorTheme, 50)

// Heikin Ashi [Improved] Calculations
close0 = (open + high + low + close) / 4
close0 := na(close0) ? nz(na) : (nz(close0) + nz(close)) / 2
open0 = float(na)
open0 := na(open0[1]) ? nz(na) : (nz(open0[ha_smoothness]) + nz(close0[1])) / 2
high0 = math.max(high, math.max(open0, close0))
low0 = math.min(low, math.min(open0, close0))
h0 = math.max(high0, low0)
l0 = math.min(high0, low0)

// Original Heikin Ashi Smoothness (extra layer)
haClose = (open0 + h0 + l0 + close0) / 4
haOpen = float(na)
haOpen := na(haOpen[1]) ? (open0 + close0) / 2 : (nz(haOpen[1]) + nz(haClose[1])) / 2
haHigh = math.max(h0, math.max(haOpen, haClose))
haLow = math.min(l0, math.min(haOpen, haClose))

// Determine which OHLC values to use based on candle type and smoothness option
use_ha = candle_type != 'Normal OHLC'
use_real_close = candle_type == 'Heikin Ashi (Real Close)'

plot_open = use_ha ? (ha_extra_smooth ? haOpen : open0) : open
plot_high = use_ha ? (ha_extra_smooth ? haHigh : h0) : high
plot_low = use_ha ? (ha_extra_smooth ? haLow : l0) : low
plot_close = use_ha ? (use_real_close ? close : (ha_extra_smooth ? haClose : close0)) : close

plotcandle(plot_open, plot_high, plot_low, plot_close, color = trend_color, bordercolor = trend_color, wickcolor = trend_color, display = display.pane, format = format.price, precision = 2)

//-----Background Color based on Z-Score-----//
bgcolor(bgValuationColor(valScore_s), title = 'Z-Score Background')

//-----Z-Score Border Lines-----//
// Draw markers at screen edges for overbought/oversold zones
isOversold = valScore_s <= -zScoreThreshold
isOverbought = valScore_s >= zScoreThreshold
useGlowStyle = borderLineStyle == 'Glow'

// Extract base colors without transparency for glow layers
colorOverboughtBase = color.rgb(color.r(colorOverbought), color.g(colorOverbought), color.b(colorOverbought))
colorOversoldBase = color.rgb(color.r(colorOversold), color.g(colorOversold), color.b(colorOversold))

// Calculate positions based on each candle's own high/low (for Glow mode)
topPos = high * 1.01
bottomPos = low * 0.99

// Glow mode values
overboughtGlowVal = enableZScoreBorderLines and useGlowStyle and isOverbought ? topPos : na
oversoldGlowVal = enableZScoreBorderLines and useGlowStyle and isOversold ? bottomPos : na

// Overbought glow layers - circles at same position, different linewidths (outer to core)
plot(overboughtGlowVal, style = plot.style_circles, color = color.new(colorOverboughtBase, 85), linewidth = 5, title = 'Overbought Glow 1', display = display.pane)
plot(overboughtGlowVal, style = plot.style_circles, color = color.new(colorOverboughtBase, 70), linewidth = 4, title = 'Overbought Glow 2', display = display.pane)
plot(overboughtGlowVal, style = plot.style_circles, color = color.new(colorOverboughtBase, 50), linewidth = 3, title = 'Overbought Glow 3', display = display.pane)
plot(overboughtGlowVal, style = plot.style_circles, color = color.new(colorOverboughtBase, 25), linewidth = 2, title = 'Overbought Glow 4', display = display.pane)
plot(overboughtGlowVal, style = plot.style_circles, color = color.new(colorOverboughtBase, 0), linewidth = 1, title = 'Overbought Core', display = display.pane)

// Oversold glow layers - circles at same position, different linewidths (outer to core)
plot(oversoldGlowVal, style = plot.style_circles, color = color.new(colorOversoldBase, 85), linewidth = 5, title = 'Oversold Glow 1', display = display.pane)
plot(oversoldGlowVal, style = plot.style_circles, color = color.new(colorOversoldBase, 70), linewidth = 4, title = 'Oversold Glow 2', display = display.pane)
plot(oversoldGlowVal, style = plot.style_circles, color = color.new(colorOversoldBase, 50), linewidth = 3, title = 'Oversold Glow 3', display = display.pane)
plot(oversoldGlowVal, style = plot.style_circles, color = color.new(colorOversoldBase, 25), linewidth = 2, title = 'Oversold Glow 4', display = display.pane)
plot(oversoldGlowVal, style = plot.style_circles, color = color.new(colorOversoldBase, 0), linewidth = 1, title = 'Oversold Core', display = display.pane)

// Simple mode - plotshape at screen top/bottom edges
plotshape(enableZScoreBorderLines and not useGlowStyle and isOverbought, style = shape.circle, location = location.top, color = colorOverbought, size = size.tiny, title = 'Overbought Simple', display = display.pane)
plotshape(enableZScoreBorderLines and not useGlowStyle and isOversold, style = shape.circle, location = location.bottom, color = colorOversold, size = size.tiny, title = 'Oversold Simple', display = display.pane)

