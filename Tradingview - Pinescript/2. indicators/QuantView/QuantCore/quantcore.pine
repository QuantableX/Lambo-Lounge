dexScore_10_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_010_length, Dex_MA_Type))
dexScore_11_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_011_length, Dex_MA_Type))
dexScore_12_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_012_length, Dex_MA_Type))
dexScore_13_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_013_length, Dex_MA_Type))
dexScore_14_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_014_length, Dex_MA_Type))
dexScore_15_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_015_length, Dex_MA_Type))
dexScore_16_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_016_length, Dex_MA_Type))
dexScore_17_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_017_length, Dex_MA_Type))
dexScore_18_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_018_length, Dex_MA_Type))
dexScore_19_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_019_length, Dex_MA_Type))
dexScore_20_s_raw = request.security(syminfo.tickerid, short_tf, priceVsMA(y_020_length, Dex_MA_Type))

// Apply confirmed offset for Short Term QuantDEX
dexScore_01_s = dexScore_01_s_raw[confirmedOffset]
dexScore_02_s = dexScore_02_s_raw[confirmedOffset]
dexScore_03_s = dexScore_03_s_raw[confirmedOffset]
dexScore_04_s = dexScore_04_s_raw[confirmedOffset]
